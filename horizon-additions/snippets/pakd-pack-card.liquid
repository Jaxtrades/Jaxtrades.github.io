{%- doc -%}
  Inside of one PAKD pack card (used by blocks/pakd-packs.liquid).
  @param {number} tins
  @param {number} pouches
  @param {number} once - one-time price (cents)
  @param {number} [sub] - subscription price (cents)
  @param {number} off_once
  @param {number} off_sub
  @param {number} save_once
  @param {number} save_sub
  @param {string} popular_label
  @param {boolean} is_popular
  @param {boolean} available
{%- enddoc -%}
<span class="pakd-pack__tags">
  {%- if off_once > 0 -%}<span class="pakd-pack__off" data-show="one">{{ off_once }}% off</span>{%- endif -%}
  {%- if sub and off_sub > 0 -%}<span class="pakd-pack__off" data-show="sub">{{ off_sub }}% off</span>{%- endif -%}
  {%- if is_popular and popular_label != blank -%}<span class="pakd-pack__pop">★ {{ popular_label }}</span>{%- endif -%}
</span>
<span class="pakd-pack__head">
  <span class="pakd-pack__dot" aria-hidden="true"></span>
  <span class="pakd-pack__tins">{{ tins }} {% if tins == 1 %}Tin{% else %}Tins{% endif %}</span>
  <span class="pakd-pack__pouches">{{ pouches }} pouches</span>
</span>
<span class="pakd-pack__deal">
  <span class="pakd-pack__price" data-show="one">{{ once | money }}</span>
  <span class="pakd-pack__ppp" data-show="one">{{ once | times: 1.0 | divided_by: pouches | round | money }} per pouch</span>
  {%- if save_once > 0 -%}<span class="pakd-pack__save" data-show="one">Save {{ save_once | money }}</span>{%- endif -%}
  {%- if sub -%}
    <span class="pakd-pack__price" data-show="sub">{{ sub | money }}</span>
    <span class="pakd-pack__ppp" data-show="sub">{{ sub | times: 1.0 | divided_by: pouches | round | money }} per pouch</span>
    {%- if save_sub > 0 -%}<span class="pakd-pack__save" data-show="sub">Save {{ save_sub | money }} every delivery</span>{%- endif -%}
  {%- else -%}
    <span class="pakd-pack__price" data-show="sub">{{ once | money }}</span>
    <span class="pakd-pack__ppp" data-show="sub">{{ once | times: 1.0 | divided_by: pouches | round | money }} per pouch</span>
  {%- endif -%}
</span>
{%- unless available -%}<span class="pakd-pack__soldout">Sold out</span>{%- endunless -%}
