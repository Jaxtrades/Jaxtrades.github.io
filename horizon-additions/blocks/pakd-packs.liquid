{%- comment -%}
  PAKD pack cards ("Choose your bundle"): 1 / 3 / 5 / 10 tins with pouches, price per pouch,
  % off and dollar saving, plus an optional "Most popular" tag.

  How it works
  - Needs a product option named like the "Pack option name" setting (default "Pack"),
    with values that start with the tin count, e.g. "1 Tin", "3 Tins", "5 Tins", "10 Tins".
  - Each card selects that pack through Horizon's own variant picker (hidden for this option),
    so price, URL, Add to cart and the cart drawer all keep working as normal.
  - Prices come from Shopify: the variant price (one-time) and its subscription price when the
    shopper picks "Subscribe & Save" in the PAKD purchase options block.
  - % off and saving compare each pack with buying single tins one-time.
  - With no Pack option yet, sample cards show in draft previews only, never to customers.
{%- endcomment -%}
{%- render 'pakd-tokens' -%}
{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  assign opt_name = block.settings.option_name | default: 'Pack' | strip
  assign pouches_per_tin = block.settings.pouches | default: 20

  assign pack_option = blank
  for o in product.options_with_values
    if o.name == opt_name
      assign pack_option = o
    endif
  endfor

  assign demo = false
  if pack_option == blank and block.settings.preview_in_editor
    if request.design_mode or theme.role == 'unpublished'
      assign demo = true
    endif
  endif

  # Base = the 1-tin price used for % off and savings
  assign base_price = product.selected_or_first_available_variant.price
  if pack_option != blank
    for val in pack_option.values
      assign t = val.name | split: ' ' | first | plus: 0
      if t == 1 and val.variant
        assign base_price = val.variant.price
        break
      endif
    endfor
  endif
-%}
<pakd-live-block
  class="pakd-packs"
  data-block-id="{{ block.id }}"
  data-mode="one"
  data-option-name="{{ opt_name | escape }}"
  {{ block.shopify_attributes }}
>
  {%- if pack_option != blank or demo -%}
    <p class="pakd-packs__heading" id="PakdPacks-{{ block.id }}">{{ block.settings.heading }}</p>
    <div class="pakd-packs__grid" role="radiogroup" aria-labelledby="PakdPacks-{{ block.id }}">
      {%- if pack_option != blank -%}
        {%- for val in pack_option.values -%}
          {%- liquid
            assign v = val.variant
            assign tins = v.metafields.pakd.tins.value
            if tins == blank
              assign tins = val.name | split: ' ' | first | plus: 0
            endif
            if tins < 1
              assign tins = 1
            endif
            assign pouches = pouches_per_tin | times: tins
            assign full = base_price | times: tins

            assign once = v.price
            assign sub = nil
            if v.selling_plan_allocations.size > 0
              assign sub = v.selling_plan_allocations.first.price
            endif

            assign save_once = full | minus: once
            assign off_once = 0
            if full > 0 and save_once > 0
              assign off_once = save_once | times: 100.0 | divided_by: full | round
            endif
            assign save_sub = 0
            assign off_sub = 0
            if sub
              assign save_sub = full | minus: sub
              if full > 0 and save_sub > 0
                assign off_sub = save_sub | times: 100.0 | divided_by: full | round
              endif
            endif
            assign is_popular = false
            if block.settings.popular_value != blank and val.name == block.settings.popular_value
              assign is_popular = true
            endif
          -%}
          <button
            type="button"
            class="pakd-pack{% if val.selected %} is-selected{% endif %}{% if is_popular %} is-popular{% endif %}"
            role="radio"
            aria-checked="{% if val.selected %}true{% else %}false{% endif %}"
            data-pack-value="{{ val.name | escape }}"
            {% unless val.available %}aria-disabled="true"{% endunless %}
          >
            {%- render 'pakd-pack-card',
              tins: tins, pouches: pouches, once: once, sub: sub,
              off_once: off_once, off_sub: off_sub, save_once: save_once, save_sub: save_sub,
              popular_label: block.settings.popular_label, is_popular: is_popular, available: val.available
            -%}
          </button>
        {%- endfor -%}
      {%- else -%}
        {%- assign demo_tins = block.settings.demo_tins | split: ',' -%}
        {%- assign demo_offs = block.settings.demo_discounts | split: ',' -%}
        {%- for raw in demo_tins -%}
          {%- liquid
            assign tins = raw | strip | plus: 0
            assign off = demo_offs[forloop.index0] | strip | plus: 0
            assign pouches = pouches_per_tin | times: tins
            assign full = base_price | times: tins
            assign keep = 100 | minus: off
            assign once = full | times: keep | divided_by: 100
            assign save_once = full | minus: once
            assign is_popular = false
            assign label_value = tins | append: ' Tins'
            if tins == 1
              assign label_value = '1 Tin'
            endif
            if block.settings.popular_value != blank and label_value == block.settings.popular_value
              assign is_popular = true
            endif
          -%}
          <button type="button" class="pakd-pack{% if forloop.first %} is-selected{% endif %}{% if is_popular %} is-popular{% endif %}" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" data-demo>
            {%- render 'pakd-pack-card',
              tins: tins, pouches: pouches, once: once, sub: nil,
              off_once: off, off_sub: 0, save_once: save_once, save_sub: 0,
              popular_label: block.settings.popular_label, is_popular: is_popular, available: true
            -%}
          </button>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if demo -%}
      <p class="pakd-packs__demo">Draft preview only, with sample discounts. Add a "{{ opt_name }}" option (1 Tin, 3 Tins, 5 Tins, 10 Tins) with real prices to show this to customers.</p>
    {%- endif -%}
  {%- endif -%}
</pakd-live-block>

<style>
  /* Hide Horizon's own picker for the pack option; the cards drive it instead. */
  {%- if pack_option != blank -%}
  #shopify-section-{{ section.id }} variant-picker fieldset:has(input[data-option-name="{{ opt_name | escape }}"]),
  #shopify-section-{{ section.id }} variant-picker .variant-option--dropdowns:has(select[name="options[{{ opt_name | escape }}]"]) { display: none; }
  {%- endif -%}
</style>

{% stylesheet %}
  .pakd-packs { display: flex; flex-direction: column; gap: 12px; width: 100%; color: var(--pakd-ink, #0A2540); }
  .pakd-packs__heading { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--pakd-support, #2D5778); }
  .pakd-packs__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 10px; padding-top: 10px; }
  .pakd-pack {
    position: relative; display: flex; flex-direction: column; gap: 10px; text-align: left;
    font: inherit; color: inherit; cursor: pointer;
    padding: 18px 12px 12px; border-radius: 16px; background: #fff;
    border: 1.5px solid var(--pakd-line, #D6E9F5);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .pakd-pack:hover { border-color: #9cc9ec; }
  .pakd-pack.is-selected { border-color: var(--pakd-primary, #0077FF); box-shadow: 0 0 0 1px var(--pakd-primary, #0077FF); }
  .pakd-pack:focus-visible { outline: 3px solid rgba(0, 119, 255, .35); outline-offset: 2px; }
  .pakd-pack[aria-disabled='true'] { opacity: .5; cursor: not-allowed; }
  .pakd-pack__tags { position: absolute; top: 0; left: 50%; transform: translate(-50%, -55%); display: flex; gap: 4px; white-space: nowrap; }
  .pakd-pack__off, .pakd-pack__pop { font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; }
  .pakd-pack__off { background: var(--pakd-primary, #0077FF); color: #fff; }
  .pakd-pack__pop { background: var(--pakd-ink, #0A2540); color: #fff; }
  .pakd-pack__head { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; }
  .pakd-pack__dot { flex: 0 0 18px; width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid var(--pakd-line, #D6E9F5); display: grid; place-items: center; }
  .pakd-pack.is-selected .pakd-pack__dot { border-color: var(--pakd-primary, #0077FF); }
  .pakd-pack.is-selected .pakd-pack__dot::after { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--pakd-primary, #0077FF); }
  .pakd-pack__tins { font-weight: 700; font-size: 17px; letter-spacing: -.01em; }
  .pakd-pack__pouches { font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--pakd-support, #2D5778); }
  .pakd-pack__deal { display: grid; gap: 2px; padding: 10px 12px; border-radius: 12px; background: var(--pakd-ice, #EAF6FD); }
  .pakd-pack__price { font-size: 17px; font-weight: 700; }
  .pakd-pack__ppp { font-size: 13px; font-weight: 600; color: var(--pakd-ink, #0A2540); }
  .pakd-pack__save { font-size: 12px; color: #0B6B4F; font-weight: 600; }
  .pakd-pack__soldout { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--pakd-support, #2D5778); }
  .pakd-packs[data-mode='one'] [data-show='sub'], .pakd-packs[data-mode='sub'] [data-show='one'] { display: none !important; }
  .pakd-packs__demo { margin: 0; font-size: 12px; color: #A35B00; }
  @media (max-width: 480px) {
    .pakd-packs__grid { gap: 10px; padding-top: 0; }
    .pakd-pack__tags { position: static; transform: none; flex-wrap: wrap; white-space: normal; }
    .pakd-pack__tags:empty { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .pakd-pack { transition: none; } }
{% endstylesheet %}

{% render 'pakd-live-block-script' %}

<script type="module">
  if (!window.pakdPacks) {
    window.pakdPacks = true;

    // Follow the One-time / Subscribe choice in the PAKD purchase options block of the same section
    const syncMode = (packs) => {
      const section = packs.closest('.shopify-section, dialog');
      const buy = section?.querySelector('pakd-live-block.pakd-buy');
      const mode = buy?.dataset.mode === 'sub' && buy.querySelector('[data-plan-input]:not([data-demo])') ? 'sub' : 'one';
      packs.dataset.mode = mode;
    };
    const syncAll = () => document.querySelectorAll('pakd-live-block.pakd-packs').forEach(syncMode);

    const choose = (button) => {
      const packs = button.closest('pakd-live-block.pakd-packs');
      if (!packs || button.getAttribute('aria-disabled') === 'true') return;
      packs.querySelectorAll('.pakd-pack').forEach((b) => {
        const on = b === button;
        b.classList.toggle('is-selected', on);
        b.setAttribute('aria-checked', String(on));
      });
      if (button.hasAttribute('data-demo')) return;
      const value = button.dataset.packValue;
      const name = packs.dataset.optionName;
      const section = packs.closest('.shopify-section, dialog');
      const radio = Array.from(section?.querySelectorAll(`variant-picker input[type="radio"][data-option-name]`) || [])
        .find((i) => i.dataset.optionName === name && i.value === value);
      if (radio) { if (!radio.checked) radio.click(); return; }
      const select = section?.querySelector(`variant-picker select[name="options[${CSS.escape(name)}]"]`);
      if (select && select.value !== value) {
        select.value = value;
        select.dispatchEvent(new Event('change', { bubbles: true }));
      }
    };

    document.addEventListener('click', (event) => {
      const button = event.target.closest?.('pakd-live-block.pakd-packs .pakd-pack');
      if (button) choose(button);
    });
    document.addEventListener('keydown', (event) => {
      const button = event.target.closest?.('pakd-live-block.pakd-packs .pakd-pack');
      if (!button || !['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp'].includes(event.key)) return;
      event.preventDefault();
      const all = Array.from(button.parentElement.querySelectorAll('.pakd-pack:not([aria-disabled="true"])'));
      const step = ['ArrowRight', 'ArrowDown'].includes(event.key) ? 1 : -1;
      const next = all[(all.indexOf(button) + step + all.length) % all.length];
      next?.focus();
      if (next) choose(next);
    });
    document.addEventListener('change', () => setTimeout(syncAll, 0));
    document.addEventListener('pakd:refresh', () => setTimeout(syncAll, 0), true);
    syncAll();
  }
</script>

{% schema %}
{
  "name": "PAKD pack cards",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Shows bundle cards for a product option such as Pack: 1 Tin, 3 Tins, 5 Tins, 10 Tins. Prices, % off and savings are worked out from the real variant and subscription prices." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your bundle" },
    { "type": "text", "id": "option_name", "label": "Pack option name", "default": "Pack", "info": "Must match the product option name exactly. Values should start with the tin count, e.g. 3 Tins." },
    { "type": "range", "id": "pouches", "label": "Pouches per tin", "min": 1, "max": 60, "step": 1, "default": 20 },
    { "type": "text", "id": "popular_value", "label": "Most popular pack", "default": "5 Tins", "info": "The pack value to tag, e.g. 5 Tins. Leave blank for none." },
    { "type": "text", "id": "popular_label", "label": "Most popular tag", "default": "Most popular" },
    { "type": "header", "content": "Draft preview (no Pack option yet)" },
    { "type": "checkbox", "id": "preview_in_editor", "label": "Show sample cards in draft previews", "default": true },
    { "type": "text", "id": "demo_tins", "label": "Sample pack sizes", "default": "1, 3, 5, 10" },
    { "type": "text", "id": "demo_discounts", "label": "Sample % off per pack", "default": "0, 15, 25, 35", "info": "Preview only. Real discounts come from your variant prices." }
  ],
  "presets": [{ "name": "PAKD pack cards", "category": "PAKD" }]
}
{% endschema %}
