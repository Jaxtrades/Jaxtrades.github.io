{%- comment -%}
  QUIT STICK – ORDER CONFIRMATION
  Paste this whole file into Shopify admin → Settings → Notifications →
  Customer notifications → Order confirmation → Edit code.

  Change these to match your brand. Leave a value empty ('') to hide it.
{%- endcomment -%}
{%- assign donation_per_kit = 5 -%}
{%- assign kit_keyword = 'Starter Kit' -%}
{%- assign charity_name = 'Lung Foundation Australia' -%}
{%- assign hashtag = '#OneOfUs' -%}
{%- assign social_handle = '' -%}
{%- assign social_url = '' -%}
{%- assign support_email = shop.email -%}

{%- liquid
  assign kit_count = 0
  assign has_subscription = false
  assign hero_line = line_items.first
  for line in line_items
    if line.product.title contains kit_keyword or line.title contains kit_keyword
      assign kit_count = kit_count | plus: line.quantity
      assign hero_line = line
    endif
    if line.selling_plan_allocation
      assign has_subscription = true
    endif
  endfor
  assign donation = kit_count | times: donation_per_kit
  assign first_name = customer.first_name | default: billing_address.first_name | default: shipping_address.first_name
-%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Order {{ order_name }} confirmed</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  body{margin:0;padding:0;background:#E9E6DD;-webkit-text-size-adjust:100%}
  table{border-collapse:collapse}
  img{border:0;display:block;max-width:100%;height:auto}
  a{color:#17332D}
  .f{font-family:'Poppins',Helvetica,Arial,sans-serif}
  @media (max-width:620px){
    .wrap{width:100%!important}
    .px{padding-left:22px!important;padding-right:22px!important}
    .h1{font-size:40px!important}
    .col{display:block!important;width:100%!important;padding-left:0!important;padding-right:0!important}
    .col-pad{padding-bottom:14px!important}
    .stat{display:block!important;width:100%!important;border-left:0!important;border-top:1px solid rgba(255,255,255,.18)!important}
  }
</style>
</head>
<body class="f" style="margin:0;padding:0;background:#E9E6DD">
<div style="display:none;max-height:0;overflow:hidden;opacity:0">Order {{ order_name }} is confirmed{% if donation > 0 %}, and ${{ donation }} from your {% if kit_count > 1 %}kits{% else %}kit{% endif %} is already on its way to {{ charity_name }}{% endif %}.</div>

<table role="presentation" width="100%" style="background:#E9E6DD">
<tr><td align="center" style="padding:24px 12px">
<table role="presentation" class="wrap" width="600" style="width:600px;max-width:600px;background:#F4F2EC">

  <!-- Top bar -->
  <tr><td class="px f" style="background:#17332D;padding:18px 36px">
    <table role="presentation" width="100%"><tr>
      <td class="f" style="color:#ffffff;font-size:17px;font-weight:800;letter-spacing:.2em">
        {%- if shop.email_logo_url -%}
          <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="{{ shop.email_logo_width | default: 140 }}">
        {%- else -%}
          QUIT STICK
        {%- endif -%}
      </td>
      <td class="f" align="right" style="color:rgba(255,255,255,.75);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase">Order {{ order_name }}</td>
    </tr></table>
  </td></tr>

  <!-- Hero -->
  <tr><td class="px f" style="padding:44px 36px 0;color:#17332D">
    <p style="margin:0 0 14px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#C8553D">&#9679;&nbsp; Order confirmed</p>
    <h1 class="h1" style="margin:0;font-size:52px;line-height:.98;font-weight:800;letter-spacing:-.02em;text-transform:uppercase;color:#17332D">You're one<br>of us <span style="color:#C8553D">now.</span></h1>
    <p style="margin:22px 0 0;font-size:16px;line-height:1.6;color:#3E4B46">Hey{% if first_name != blank %} {{ first_name }}{% endif %},</p>
    <p style="margin:10px 0 0;font-size:16px;line-height:1.6;color:#3E4B46">Your order is in. But you didn't just buy a stick. You joined a growing crew of people who decided the smoke break doesn't get to run their day anymore, and every one of you is helping someone else breathe easier too.</p>
  </td></tr>

  <!-- Member card -->
  <tr><td class="px" style="padding:28px 36px 0">
    <table role="presentation" width="100%" style="background:#17332D;border-radius:18px">
      <tr>
        <td class="f" style="padding:26px 28px;color:#ffffff;vertical-align:middle">
          <p style="margin:0;font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.65)">Quit Stick member</p>
          <p style="margin:6px 0 0;font-size:34px;font-weight:800;letter-spacing:-.01em;line-height:1;color:#ffffff">No. {{ order_number }}</p>
          <p style="margin:12px 0 0;font-size:13px;line-height:1.5;color:rgba(255,255,255,.8)">Joined {{ created_at | date: "%-d %B %Y" }}{% if hero_line.variant.title != blank and hero_line.variant.title != 'Default Title' %}<br>{{ hero_line.variant.title }} finish{% endif %}</p>
        </td>
        {%- if hero_line.image -%}
        <td width="150" style="padding:14px 14px 14px 0;vertical-align:middle">
          <img src="{{ hero_line | img_url: '300x300' }}" width="136" alt="{{ hero_line.title | escape }}" style="border-radius:12px;background:#ffffff">
        </td>
        {%- endif -%}
      </tr>
    </table>
  </td></tr>

  <!-- Order summary -->
  <tr><td class="px" style="padding:36px 36px 0">
    <p class="f" style="margin:0 0 12px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#5F6B66">Your order</p>
    <table role="presentation" width="100%" style="background:#ffffff;border:1px solid #E4E0D6;border-radius:16px">
      <tr><td style="padding:8px 20px">
        <table role="presentation" width="100%">
          {%- for line in subtotal_line_items -%}
          <tr>
            <td width="72" style="padding:14px 0;border-bottom:1px solid #EFECE4;vertical-align:middle">
              {%- if line.image -%}<img src="{{ line | img_url: 'compact_cropped' }}" width="60" alt="" style="border-radius:10px;background:#F4F2EC">{%- endif -%}
            </td>
            <td class="f" style="padding:14px 8px 14px 0;border-bottom:1px solid #EFECE4;color:#17332D;font-size:14px;line-height:1.4;vertical-align:middle">
              <b>{{ line.product.title | default: line.title }}</b><br>
              <span style="color:#5F6B66;font-size:13px">
                {%- if line.variant.title != blank and line.variant.title != 'Default Title' -%}{{ line.variant.title }} &middot; {% endif -%}
                Qty {{ line.quantity }}
                {%- if line.selling_plan_allocation -%}<br>{{ line.selling_plan_allocation.selling_plan.name }}{%- endif -%}
              </span>
            </td>
            <td class="f" align="right" style="padding:14px 0;border-bottom:1px solid #EFECE4;color:#17332D;font-size:14px;font-weight:600;white-space:nowrap;vertical-align:middle">
              {%- if line.original_line_price > line.final_line_price -%}<s style="color:#9AA19D;font-weight:400">{{ line.original_line_price | money }}</s>&nbsp;{%- endif -%}
              {%- if line.final_line_price == 0 -%}Free{%- else -%}{{ line.final_line_price | money }}{%- endif -%}
            </td>
          </tr>
          {%- endfor -%}
        </table>
        <table role="presentation" width="100%" class="f" style="font-size:14px;color:#3E4B46">
          <tr><td style="padding:14px 0 4px">Subtotal</td><td align="right" style="padding:14px 0 4px">{{ subtotal_price | money }}</td></tr>
          {%- for discount_application in discount_applications -%}
            {%- if discount_application.target_selection == 'all' -%}
            <tr><td style="padding:4px 0">Discount <span style="display:inline-block;background:#EAF1EC;color:#17332D;font-size:11px;font-weight:700;letter-spacing:.06em;padding:2px 8px;border-radius:999px">{{ discount_application.title | upcase }}</span></td><td align="right" style="padding:4px 0;color:#4E8F6C">&minus;{{ discount_application.total_allocated_amount | money }}</td></tr>
            {%- endif -%}
          {%- endfor -%}
          {%- if requires_shipping -%}
          <tr><td style="padding:4px 0">Shipping</td><td align="right" style="padding:4px 0">{% if shipping_price == 0 %}Free{% else %}{{ shipping_price | money }}{% endif %}</td></tr>
          {%- endif -%}
          {%- if total_tip and total_tip > 0 -%}
          <tr><td style="padding:4px 0">Tip</td><td align="right" style="padding:4px 0">{{ total_tip | money }}</td></tr>
          {%- endif -%}
          <tr><td style="padding:12px 0 4px;border-top:1px solid #EFECE4;font-size:18px;font-weight:800;color:#17332D">Total</td><td align="right" style="padding:12px 0 4px;border-top:1px solid #EFECE4;font-size:18px;font-weight:800;color:#17332D">{{ total_price | money_with_currency }}</td></tr>
          {%- if tax_price > 0 -%}
          <tr><td colspan="2" style="padding:0 0 4px;font-size:12px;color:#5F6B66">{% if taxes_included %}Including{% else %}Plus{% endif %} {{ tax_price | money }} in taxes</td></tr>
          {%- endif -%}
          {%- if total_discounts > 0 -%}
          <tr><td colspan="2" style="padding:0 0 4px;font-size:12px;color:#4E8F6C;font-weight:600">You saved {{ total_discounts | money }}</td></tr>
          {%- endif -%}
          <tr><td colspan="2" style="padding:0 0 12px"></td></tr>
        </table>
      </td></tr>
    </table>
    <table role="presentation" width="100%" style="margin-top:12px">
      <tr>
        {%- if shipping_address -%}
        <td class="col col-pad f" width="50%" style="padding-right:6px;vertical-align:top">
          <div style="background:#ffffff;border:1px solid #E4E0D6;border-radius:14px;padding:16px 18px;font-size:13px;line-height:1.55;color:#3E4B46"><b style="display:block;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#5F6B66;margin-bottom:6px">Shipping to</b>{{ shipping_address.name }}<br>{{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}<br>{{ shipping_address.address2 }}{% endif %}<br>{{ shipping_address.city }} {{ shipping_address.province_code }} {{ shipping_address.zip }}</div>
        </td>
        {%- endif -%}
        <td class="col f" {% if shipping_address %}width="50%" style="padding-left:6px;vertical-align:top"{% else %}style="vertical-align:top"{% endif %}>
          <div style="background:#ffffff;border:1px solid #E4E0D6;border-radius:14px;padding:16px 18px;font-size:13px;line-height:1.55;color:#3E4B46"><b style="display:block;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#5F6B66;margin-bottom:6px">What happens next</b>We're packing your order now. You'll get a tracking link by email as soon as it ships.</div>
        </td>
      </tr>
    </table>
  </td></tr>

  <!-- Impact -->
  <tr><td class="px" style="padding:40px 36px 0">
    <table role="presentation" width="100%" style="background:#C8553D;border-radius:18px">
      <tr><td class="f" style="padding:32px 28px 8px;color:#ffffff">
        <p style="margin:0;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.8)">{% if donation > 0 %}Your order is already doing good{% else %}Part of something bigger{% endif %}</p>
        {%- if donation > 0 -%}
          <p style="margin:10px 0 0;font-size:30px;line-height:1.1;font-weight:800;letter-spacing:-.01em;color:#ffffff">${{ donation }} from your {% if kit_count > 1 %}kits is{% else %}kit is{% endif %} on its way to {{ charity_name }}.</p>
          <p style="margin:12px 0 0;font-size:15px;line-height:1.6;color:rgba(255,255,255,.9)">We give ${{ donation_per_kit }} from every Starter Kit to lung health in Australia. You made that happen today.</p>
        {%- else -%}
          <p style="margin:10px 0 0;font-size:30px;line-height:1.1;font-weight:800;letter-spacing:-.01em;color:#ffffff">Every Starter Kit sends ${{ donation_per_kit }} to {{ charity_name }}.</p>
          <p style="margin:12px 0 0;font-size:15px;line-height:1.6;color:rgba(255,255,255,.9)">By sticking with it, you're part of a community that's giving back to lung health with every new member.</p>
        {%- endif -%}
      </td></tr>
      <tr><td style="padding:18px 16px 24px">
        <table role="presentation" width="100%" class="f" style="color:#ffffff;text-align:center">
          <tr>
            <td class="stat" width="33%" style="padding:12px 6px;color:#ffffff"><b style="display:block;font-size:26px;font-weight:800">${% if donation > 0 %}{{ donation }}{% else %}{{ donation_per_kit }}{% endif %}</b><span style="font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.75)">{% if donation > 0 %}From you{% else %}Per Starter Kit{% endif %}</span></td>
            <td class="stat" width="34%" style="padding:12px 6px;border-left:1px solid rgba(255,255,255,.25);color:#ffffff"><b style="display:block;font-size:26px;font-weight:800">No. {{ order_number }}</b><span style="font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.75)">Your member number</span></td>
            <td class="stat" width="33%" style="padding:12px 6px;border-left:1px solid rgba(255,255,255,.25);color:#ffffff"><b style="display:block;font-size:26px;font-weight:800">0 mg</b><span style="font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.75)">Nicotine, always</span></td>
          </tr>
        </table>
      </td></tr>
    </table>
  </td></tr>

  <!-- Member perks -->
  <tr><td class="px f" style="padding:44px 36px 0;color:#17332D">
    <h2 style="margin:0;font-size:26px;line-height:1.1;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;color:#17332D">As a member,<br>you'll always get:</h2>
    <table role="presentation" width="100%" style="margin-top:22px">
      <tr>
        <td class="col col-pad" width="33%" style="padding-right:6px;vertical-align:top">
          <div style="background:#ffffff;border:1px solid #E4E0D6;border-radius:14px;padding:20px 16px;text-align:center">
            <div style="width:44px;height:44px;line-height:44px;margin:0 auto;border-radius:50%;background:#EAF1EC;font-size:20px">&#127807;</div>
            <p style="margin:12px 0 4px;font-size:14px;font-weight:700;color:#17332D">Real flavour</p>
            <p style="margin:0;font-size:12px;line-height:1.5;color:#5F6B66">Flavoured air. No smoke, vapour or battery.</p>
          </div>
        </td>
        <td class="col col-pad" width="34%" style="padding:0 3px;vertical-align:top">
          <div style="background:#ffffff;border:1px solid #E4E0D6;border-radius:14px;padding:20px 16px;text-align:center">
            <div style="width:44px;height:44px;line-height:44px;margin:0 auto;border-radius:50%;background:#EAF1EC;font-size:20px">&#128230;</div>
            <p style="margin:12px 0 4px;font-size:14px;font-weight:700;color:#17332D">Refills on your terms</p>
            <p style="margin:0;font-size:12px;line-height:1.5;color:#5F6B66">Subscribe and save, or top up when you need to.</p>
          </div>
        </td>
        <td class="col" width="33%" style="padding-left:6px;vertical-align:top">
          <div style="background:#ffffff;border:1px solid #E4E0D6;border-radius:14px;padding:20px 16px;text-align:center">
            <div style="width:44px;height:44px;line-height:44px;margin:0 auto;border-radius:50%;background:#EAF1EC;font-size:20px">&#129729;</div>
            <p style="margin:12px 0 4px;font-size:14px;font-weight:700;color:#17332D">${{ donation_per_kit }} to lung health</p>
            <p style="margin:0;font-size:12px;line-height:1.5;color:#5F6B66">From every Starter Kit, for as long as we're around.</p>
          </div>
        </td>
      </tr>
    </table>
  </td></tr>

  <!-- Roadmap -->
  <tr><td class="px f" style="padding:44px 36px 0;color:#17332D">
    <h2 style="margin:0;font-size:26px;line-height:1.1;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;color:#17332D">Your first<br><span style="color:#C8553D">45 days.</span></h2>
    <p style="margin:12px 0 0;font-size:15px;line-height:1.6;color:#5F6B66">There's no magic switch. There's just swapping one moment at a time. Here's what that usually looks like.</p>
    <table role="presentation" width="100%" style="margin-top:20px">
      <tr><td style="padding:0 0 12px">
        <table role="presentation" width="100%" style="background:#ffffff;border:1px solid #E4E0D6;border-left:5px solid #17332D;border-radius:12px"><tr><td class="f" style="padding:16px 18px">
          <p style="margin:0;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#C8553D">Day 1 &middot; Unbox</p>
          <p style="margin:6px 0 0;font-size:15px;font-weight:700;color:#17332D">Pick your first flavour.</p>
          <p style="margin:4px 0 0;font-size:13px;line-height:1.55;color:#5F6B66">Slide a core into the barrel and take a slow draw, like a straw. That's it. No charging, no setup.</p>
        </td></tr></table>
      </td></tr>
      <tr><td style="padding:0 0 12px">
        <table role="presentation" width="100%" style="background:#ffffff;border:1px solid #E4E0D6;border-left:5px solid #17332D;border-radius:12px"><tr><td class="f" style="padding:16px 18px">
          <p style="margin:0;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#C8553D">Days 2&ndash;7 &middot; Swap the moments</p>
          <p style="margin:6px 0 0;font-size:15px;font-weight:700;color:#17332D">Find your trigger times.</p>
          <p style="margin:4px 0 0;font-size:13px;line-height:1.55;color:#5F6B66">Morning coffee, the drive, after dinner. Reach for the stick there first. Your hands and mouth keep the ritual.</p>
        </td></tr></table>
      </td></tr>
      <tr><td style="padding:0 0 12px">
        <table role="presentation" width="100%" style="background:#ffffff;border:1px solid #E4E0D6;border-left:5px solid #17332D;border-radius:12px"><tr><td class="f" style="padding:16px 18px">
          <p style="margin:0;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#C8553D">Weeks 2&ndash;5 &middot; Make it yours</p>
          <p style="margin:6px 0 0;font-size:15px;font-weight:700;color:#17332D">The ritual stays. The smoke doesn't.</p>
          <p style="margin:4px 0 0;font-size:13px;line-height:1.55;color:#5F6B66">Rotate flavours so it stays interesting. Each core lasts up to about three days.</p>
        </td></tr></table>
      </td></tr>
      <tr><td>
        <table role="presentation" width="100%" style="background:#17332D;border-radius:12px"><tr><td class="f" style="padding:16px 18px;color:#ffffff">
          <p style="margin:0;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#F2A48F">Around day 45 &middot; Fresh flavours</p>
          {%- if has_subscription -%}
            <p style="margin:6px 0 0;font-size:15px;font-weight:700;color:#ffffff">Your refill lands as your last core fades.</p>
            <p style="margin:4px 0 0;font-size:13px;line-height:1.55;color:rgba(255,255,255,.8)">No running out, no going back to the servo. You can skip or cancel your subscription any time from your account.</p>
          {%- else -%}
            <p style="margin:6px 0 0;font-size:15px;font-weight:700;color:#ffffff">Don't let the flavour run out.</p>
            <p style="margin:4px 0 0;font-size:13px;line-height:1.55;color:rgba(255,255,255,.8)">Grab a Flavour Refill Pack before your last core fades, or subscribe and save 20% so it turns up on its own.</p>
            <table role="presentation" style="margin-top:14px"><tr><td><a href="{{ shop.url }}/products/quit-stick-flavour-refill-pack" class="f" style="display:inline-block;background:#ffffff;border-radius:999px;padding:12px 24px;color:#17332D;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-decoration:none">Get refills</a></td></tr></table>
          {%- endif -%}
        </td></tr></table>
      </td></tr>
    </table>
  </td></tr>

  <!-- Community -->
  <tr><td class="px" style="padding:44px 36px 0">
    <table role="presentation" width="100%" style="background:#EAF1EC;border-radius:18px">
      <tr><td class="f" align="center" style="padding:32px 26px;color:#17332D">
        <p style="margin:0;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#5F6B66">You're not doing this alone</p>
        <p style="margin:10px 0 0;font-size:24px;line-height:1.2;font-weight:800;color:#17332D">Share your first draw.</p>
        <p style="margin:10px auto 0;max-width:420px;font-size:14px;line-height:1.6;color:#3E4B46">Post your kit with <b>{{ hashtag }}</b>{% if social_handle != blank %} and tag <b>{{ social_handle }}</b>{% endif %}. Every story makes the next person's first day a little easier.</p>
        {%- if social_url != blank -%}
        <table role="presentation" style="margin:20px auto 0"><tr><td><a href="{{ social_url }}" class="f" style="display:inline-block;background:#17332D;border-radius:999px;padding:15px 30px;color:#ffffff;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-decoration:none">Follow the movement</a></td></tr></table>
        {%- endif -%}
      </td></tr>
    </table>
  </td></tr>

  <!-- Support -->
  <tr><td class="px f" style="padding:44px 36px 0;color:#17332D">
    <h2 style="margin:0;font-size:26px;line-height:1.1;font-weight:800;text-transform:uppercase;letter-spacing:-.01em;color:#17332D">We're here<br>to help.</h2>
    <p style="margin:12px 0 0;font-size:15px;line-height:1.6;color:#5F6B66">Questions about your order, your refills or how to get the best draw? Just reply to this email. A real person reads every one.</p>
    <table role="presentation" style="margin-top:18px"><tr><td><a href="{{ order_status_url }}" class="f" style="display:inline-block;background:#17332D;border-radius:999px;padding:15px 30px;color:#ffffff;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-decoration:none">View your order</a></td></tr></table>
    {%- if support_email != blank -%}
    <table role="presentation" style="margin-top:10px"><tr><td><a href="mailto:{{ support_email }}" class="f" style="display:inline-block;border:1.5px solid #17332D;border-radius:999px;padding:13px 28px;color:#17332D;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-decoration:none">Contact support</a></td></tr></table>
    {%- endif -%}
  </td></tr>

  <!-- Sign-off -->
  <tr><td class="px f" style="padding:40px 36px 40px;color:#17332D">
