<section class="section">
  <div class="wrap signup">
    <div class="brand" style="font-size:40px;margin-bottom:12px">{{ shop.name }}</div>
    <h1 style="font-size:clamp(34px,5vw,52px);margin:0 0 14px">{{ section.settings.heading | escape }}</h1>
    <p>{{ shop.password_message | default: section.settings.text | escape }}</p>

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <p role="status" style="flex-basis:100%">Thanks! We'll let you know when we open.</p>
      {%- else -%}
        <label for="prelaunch-email" class="sr-only">Email address</label>
        <input id="prelaunch-email" type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required>
        <button class="btn" type="submit">Notify me</button>
      {%- endif -%}
    {%- endform -%}

    <details style="margin-top:40px">
      <summary style="cursor:pointer;text-decoration:underline">Store owner? Enter password</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p role="alert" style="flex-basis:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label for="store-password" class="sr-only">Password</label>
        <input id="store-password" type="password" name="password" placeholder="Password" autocomplete="current-password" required>
        <button class="btn dark" type="submit">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "text", "id": "text", "label": "Text", "default": "Weighted plush pals are on their way. Leave your email and we'll tell you when we open." }
  ]
}
{% endschema %}
