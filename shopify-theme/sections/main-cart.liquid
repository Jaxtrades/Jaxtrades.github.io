{%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
{%- assign left = threshold | minus: cart.total_price -%}
{%- if threshold > 0 -%}{%- assign pct = cart.total_price | times: 100 | divided_by: threshold -%}{%- else -%}{%- assign pct = 100 -%}{%- endif -%}
{%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}

<div class="wrap">
  <h1 class="page-title">Your cart</h1>
  {%- if cart.item_count == 0 -%}
    <div class="empty">
      <p>Your cart is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn">Shop the pals</a>
    </div>
  {%- else -%}
    <div class="cart-page">
      <div>
        <div class="ship-bar">{% render 'ship-bar', left: left, pct: pct %}</div>
        {%- for item in cart.items -%}
          {%- render 'cart-line', item: item -%}
        {%- endfor -%}
        {%- render 'cart-upsell' -%}
      </div>
      <form class="panel" action="{{ routes.cart_url }}" method="post">
        <label for="cart-page-note" class="opt-label">Gift note</label>
        <textarea id="cart-page-note" name="note" rows="3" class="page-note" placeholder="We'll handwrite it on a card for you">{{ cart.note }}</textarea>
        <div class="sum-row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
        <div class="sum-row total" style="border-top:1px solid var(--line);padding-top:12px;margin-top:6px">
          <span>Total</span><span>{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="fine">Taxes included. Shipping calculated at checkout.</p>
        <button type="submit" name="checkout" class="btn block checkout-btn">{% render 'icon', name: 'lock' %} Checkout</button>
        <p class="instal">or 4 interest-free payments of <b>{{ cart.total_price | divided_by: 4 | money }}</b></p>
        <a href="{{ routes.all_products_collection_url }}" class="view-cart">Continue shopping</a>
      </form>
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
