{%- if section.settings.text != blank -%}
  <div class="announce">{{ section.settings.text | escape }}</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "💛 $10 from every plush donated to headspace | Free shipping over $100" }
  ]
}
{% endschema %}
