{%- if section.blocks.size > 0 -%}
  <div class="announce" data-announce data-interval="{{ section.settings.interval }}" aria-label="Store announcements" {{ section.shopify_attributes }}>
    {%- for block in section.blocks -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="announce-msg{% if forloop.first %} is-active{% endif %}" {% unless forloop.first %}aria-hidden="true" tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
      {%- else -%}
        <span class="announce-msg{% if forloop.first %} is-active{% endif %}" {% unless forloop.first %}aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <script>
      (function () {
        var bar = document.currentScript.previousElementSibling;
        var msgs = bar.querySelectorAll('.announce-msg');
        var i = 0, paused = false;
        bar.addEventListener('mouseenter', function () { paused = true; });
        bar.addEventListener('mouseleave', function () { paused = false; });
        bar.addEventListener('focusin', function () { paused = true; });
        bar.addEventListener('focusout', function () { paused = false; });
        setInterval(function () {
          if (paused || document.hidden) return;
          msgs[i].classList.remove('is-active'); msgs[i].setAttribute('aria-hidden', 'true');
          if (msgs[i].tagName === 'A') msgs[i].setAttribute('tabindex', '-1');
          i = (i + 1) % msgs.length;
          msgs[i].classList.add('is-active'); msgs[i].removeAttribute('aria-hidden'); msgs[i].removeAttribute('tabindex');
        }, (Number(bar.dataset.interval) || 4) * 1000);
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "range", "id": "interval", "label": "Seconds per message", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $100" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
