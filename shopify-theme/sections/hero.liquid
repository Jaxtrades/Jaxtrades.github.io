{%- assign price_collection = section.settings.price_collection | default: collections.all -%}
<section class="wrap hero" id="top">
  <div class="hero-card">
    <div class="hero-text">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.show_price and price_collection.products_count > 0 -%}
        <div class="hero-price">
          <span class="price">From {{ price_collection.price_min | money }}</span>
          {%- if price_collection.compare_at_price_min > price_collection.price_min -%}
            <span class="compare">{{ price_collection.compare_at_price_min | money }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="hero-actions">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button_label | escape }}</a>
        <a href="#why" class="btn outline">How it works</a>
      </div>
      <ul class="hero-perks">
        <li>{% render 'icon', name: 'truck' %}Free shipping over {{ settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros }}</li>
        <li>{% render 'icon', name: 'gift' %}Gift-ready packaging</li>
      </ul>
    </div>
    <div class="hero-media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: alt: section.settings.image.alt, fetchpriority: 'high', sizes: '(min-width: 960px) 62vw, 100vw', widths: '600, 900, 1200, 1500, 1800' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Weighted plush, made for calm" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A soft, steady hug you can keep." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Gently weighted plush pals that settle on your lap like a long, steady hug. Made for bedtime, quiet evenings and busy days." },
    { "type": "checkbox", "id": "show_price", "label": "Show \"From\" price", "default": true },
    { "type": "collection", "id": "price_collection", "label": "Price from collection", "info": "Leave empty to use all products." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the pals" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
