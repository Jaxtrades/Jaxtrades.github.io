<div class="wrap">
  <h1 class="page-title">{% if collection.handle == 'all' %}All pals{% else %}{{ collection.title }}{% endif %}</h1>
  {%- if collection.description != blank -%}
    <div class="rte" style="margin:-8px 0 40px;color:var(--ink-soft)">{{ collection.description }}</div>
  {%- else -%}
    <p style="margin:-8px 0 40px;color:var(--ink-soft)">{{ section.settings.subtitle | escape }}</p>
  {%- endif -%}
  {%- paginate collection.products by 24 -%}
    <div class="grid" style="padding-bottom:96px">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        <p>No pals here yet.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" style="padding-bottom:64px">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Gently weighted plush friends, ready to be held." }
  ]
}
{% endschema %}
