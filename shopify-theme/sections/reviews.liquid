<section class="section sand">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.note != blank -%}<p>{{ section.settings.note | escape }}</p>{%- endif -%}
    </div>
    <div class="reviews">
      {%- for block in section.blocks -%}
        <div class="review" {{ block.shopify_attributes }}>
          <div class="stars" aria-label="{{ block.settings.stars }} out of 5 stars">
            {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
          </div>
          <p>{{ block.settings.text | escape }}</p>
          <div class="who">{{ block.settings.name | escape }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our community" },
    { "type": "text", "id": "note", "label": "Note under heading", "info": "If reviews come from friends or family, say so here, e.g. \"Early reviews from friends and family\"." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "info": "Use the customer's own words." },
        { "type": "text", "id": "name", "label": "Name and details", "default": "[NAME], [SUBURB, STATE] · [PAL BOUGHT]" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
