<div class="strip">
  <div class="wrap strip-row">
    {%- for block in section.blocks -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust strip",
  "blocks": [
    { "type": "item", "name": "Item", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Gently weighted" }] }
  ],
  "presets": [{ "name": "Trust strip", "blocks": [{ "type": "item" }] }]
}
{% endschema %}
