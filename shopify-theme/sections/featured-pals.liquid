{%- assign collection = section.settings.collection | default: collections.all -%}
<section class="section" id="shop">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="grid">
      {%- for product in collection.products limit: section.settings.limit -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured pals",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the Pals" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Each pal carries gentle weight spread through the body and limbs, for an even, hug-like feel." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured pals" }]
}
{% endschema %}
