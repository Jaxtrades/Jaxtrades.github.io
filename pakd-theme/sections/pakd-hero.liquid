{%- comment -%} 2. Hero: headline, sub-line, one primary CTA, tin image, flavour chips. {%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading | default: settings.pakd_tagline
  assign sub = section.settings.subheading | default: settings.pakd_subline
  assign lines = heading | split: '. '
  assign chips = section.settings.chip_collection.products | where: 'type', section.settings.flavour_product_type
-%}
<section class="pakd-hero" data-line="recovery" aria-labelledby="Hero-{{ section.id }}">
  <div class="pakd-wrap pakd-hero__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="pakd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="pakd-hero__title" id="Hero-{{ section.id }}">
        {%- for l in lines -%}
          <span{% if forloop.last %} class="is-accent"{% endif %}>{{ l | escape }}{% unless forloop.last %}.{% endunless %}</span>
        {%- endfor -%}
      </h1>
      <p class="pakd-hero__sub">{{ sub | escape }}</p>
      <div class="pakd-hero__actions">
        <a class="pakd-btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>
      </div>
      {%- if chips.size > 0 -%}
        <p class="pakd-eyebrow">{{ chips.size }} flavours</p>
        <ul class="pakd-chips" role="list">
          {%- for p in chips -%}
            <li>
              <a class="pakd-chip" href="{{ p.url }}" style="--chip: {{ p.metafields.pakd.flavour_colour.value | default: '#B8F33A' }}" aria-label="{{ p.metafields.pakd.flavour.value | default: p.title | escape }}{% unless p.available %} (sold out){% endunless %}">
                <span class="pakd-chip__dot" aria-hidden="true"></span>{{ p.metafields.pakd.flavour.value | default: p.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        {%- render 'pakd-ph', label: 'pick the Recovery collection in this section to show flavour chips' -%}
      {%- endif -%}
    </div>

    <div class="pakd-hero__visual">
      <div class="pakd-hero__halo" aria-hidden="true"></div>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag:
          loading: 'eager', fetchpriority: 'high',
          widths: '400, 600, 800, 1000, 1200',
          sizes: '(min-width: 990px) 46rem, 90vw',
          alt: section.settings.image.alt | default: 'PAKD Recovery tin'
        }}
      {%- else -%}
        {%- liquid
          assign first = chips.first
          assign tin_colour = first.metafields.pakd.flavour_colour.value | default: '#B8F33A'
          assign tin_flavour = first.metafields.pakd.flavour.value | default: first.title
          render 'pakd-tin', colour: tin_colour, flavour: tin_flavour, line_name: 'Recovery'
        -%}
      {%- endif -%}
      {%- if settings.pakd_mascot != blank -%}
        {{ settings.pakd_mascot | image_url: width: 300 | image_tag: class: 'pakd-hero__mascot', loading: 'lazy', alt: settings.pakd_mascot.alt | default: 'PAKD mascot' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PAKD hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Recovery pouches" },
    { "type": "text", "id": "heading", "label": "Headline", "info": "Leave blank to use the brand tagline from Theme settings." },
    { "type": "text", "id": "subheading", "label": "Sub-line", "info": "Leave blank to use the brand sub-line from Theme settings." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Recovery" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Tin image", "info": "Transparent PNG/WebP, square, at least 1200px. Until set, an illustrated tin shows." },
    { "type": "text", "id": "flavour_product_type", "label": "Single-flavour product type", "default": "Recovery Pouches", "info": "Only products of this type become chips, so bundles and the Variety Pack are not counted as flavours." },
    { "type": "collection", "id": "chip_collection", "label": "Flavour chips collection", "info": "Chips list the flavours in this collection, with colours from each product's pakd.flavour_colour metafield." }
  ],
  "presets": [{ "name": "PAKD hero" }]
}
{% endschema %}
