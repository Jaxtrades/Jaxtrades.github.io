{%- comment -%}
  4. "Recover your way" selector tiles. Each block names a Product line metaobject handle
  (Content > Metaobjects > Product line). Live lines link to their collection;
  coming-soon lines show a "Tell me first" email capture tagged waitlist-<line>.
  When a line goes live, flip its status in the metaobject. No theme edit needed.
{%- endcomment -%}
<section class="pakd-section pakd-section--off" id="lines" aria-labelledby="Lines-{{ section.id }}">
  <div class="pakd-wrap">
    <div class="pakd-head">
      <div>
        <p class="pakd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="pakd-h2" id="Lines-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p class="pakd-lede">{{ section.settings.text | escape }}</p>
      </div>
    </div>

    <ul class="pakd-tiles" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign line = shop.metaobjects.pakd_line[block.settings.line_handle]
          assign key = line.accent_key.value | default: 'recovery'
          assign is_live = false
          if line.status.value == 'Live'
            assign is_live = true
          endif
          assign tile_id = 'tile-' | append: block.id
          assign tile_form_id = tile_id | append: '-form'
        -%}
        <li class="pakd-tile {% if is_live %}pakd-tile--live{% else %}pakd-tile--soon{% endif %}" data-line="{{ key }}" id="{{ tile_id }}" {{ block.shopify_attributes }}>
          {%- if line == blank -%}
            {% render 'pakd-ph', label: 'pick a Product line for this tile' %}
          {%- else -%}
            <div>
              <span class="pakd-tile__status">{% if is_live %}Live now{% else %}Coming soon{% endif %}</span>
              <h3 class="pakd-tile__name">{{ line.name.value | escape }}</h3>
              {%- if line.short_description.value != blank -%}
                <p class="pakd-tile__desc">{{ line.short_description.value | escape }}</p>
              {%- endif -%}
            </div>
            {%- if is_live -%}
              <a class="pakd-btn" href="{{ line.collection.value.url | default: routes.all_products_collection_url }}">Shop {{ line.name.value | escape }}</a>
            {%- else -%}
              {%- form 'customer', id: tile_form_id -%}
                <input type="hidden" name="contact[tags]" value="newsletter,waitlist,waitlist-{{ line.system.handle }}">
                {%- if form.posted_successfully? -%}
                  <p class="pakd-form-success" role="status">You're on the list. We'll tell you first.</p>
                {%- else -%}
                  <div class="pakd-field">
                    <label class="visually-hidden" for="{{ tile_id }}-email">Email for {{ line.name.value | escape }} launch</label>
                    <input class="pakd-input" id="{{ tile_id }}-email" type="email" name="contact[email]" autocomplete="email" placeholder="Email" required>
                    <button class="pakd-btn pakd-btn--sm" type="submit">Tell me first</button>
                  </div>
                {%- endif -%}
              {%- endform -%}
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <p class="pakd-form-note">By joining a list you agree to receive PAKD emails. Unsubscribe anytime. <a class="pakd-link" href="{{ shop.privacy_policy.url }}">Privacy</a></p>
  </div>
</section>

{% schema %}
{
  "name": "PAKD line selector",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recover your way" },
    { "type": "text", "id": "text", "label": "Text", "default": "Recovery is here now. More lines are on the way." }
  ],
  "blocks": [
    { "type": "line", "name": "Product line", "settings": [
      { "type": "text", "id": "line_handle", "label": "Product line handle", "info": "Handle of a Product line entry (Content > Metaobjects), e.g. recovery" }
    ] }
  ],
  "presets": [{ "name": "PAKD line selector" }]
}
{% endschema %}
