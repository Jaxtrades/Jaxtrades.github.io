{%- comment -%}
  3. Best sellers: one tin at a time. Arrows, dots, swipe or arrow keys move to the next product (loops).
  One block per tin. Everything is editable in the theme editor:
  - Tin image fills the circle (upload a square, top-down shot of the tin).
  - Title, short line, badge and button label are plain text settings.
  - Pick a product to pull in live price, price per pouch and add to cart.
    Price and pouch count always come from Shopify, never from typed text.
{%- endcomment -%}
<section class="pakd-section" aria-labelledby="Carousel-{{ section.id }}">
  <div class="pakd-wrap">
    <div class="pakd-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="pakd-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="pakd-h2" id="Carousel-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="pakd-lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
        <a class="pakd-link" href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_label | escape }}</a>
      {%- endif -%}
    </div>

  <pakd-carousel class="pakd-carousel" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.heading | escape }}">
    <div class="pakd-carousel__stage">
      <button type="button" class="pakd-carousel__btn pakd-carousel__btn--prev" data-dir="-1" aria-controls="Track-{{ section.id }}" aria-label="Previous product">{% render 'pakd-icon', name: 'arrow' %}</button>
      <ul class="pakd-carousel__track" id="Track-{{ section.id }}" role="list" tabindex="0" aria-live="polite">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign line = p.metafields.pakd.line.value
          assign ppt = line.pouches_per_tin.value
          assign colour = block.settings.circle_colour
          if colour == blank
            assign colour = p.metafields.pakd.flavour_colour.value | default: '#B8F33A'
          endif
          assign title = block.settings.title
          if title == blank
            assign title = p.metafields.pakd.flavour.value | default: p.title
          endif
          assign form_id = 'pakd-tin-' | append: section.id | append: '-' | append: block.id
        -%}
        <li class="pakd-tin-slide" style="--chip: {{ colour }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}: {{ title | escape }}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}
            <span class="pakd-card__badge">{{ block.settings.badge | escape }}</span>
          {%- elsif p and p.available == false -%}
            <span class="pakd-card__badge">Sold out</span>
          {%- endif -%}

          {%- capture circle -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 750px) 44rem, 80vw',
                alt: block.settings.image.alt | default: title
              }}
            {%- else -%}
              <span class="pakd-tin-slide__lid" aria-hidden="true">PAKD</span>
              {%- if request.design_mode -%}<span class="pakd-tin-slide__hint">Upload tin image</span>{%- endif -%}
            {%- endif -%}
          {%- endcapture -%}
          {%- if p -%}
            <a class="pakd-tin-slide__circle" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{{ circle }}</a>
          {%- else -%}
            <div class="pakd-tin-slide__circle">{{ circle }}</div>
          {%- endif -%}

          <div class="pakd-tin-slide__body">
            <h3 class="pakd-card__title">
              {%- if p -%}<a href="{{ p.url }}">{{ title | escape }}</a>{%- else -%}{{ title | default: 'Tin name' | escape }}{%- endif -%}
            </h3>
            <p class="pakd-card__meta">
              {%- if block.settings.text != blank -%}
                {{ block.settings.text | escape }}
              {%- elsif ppt != blank -%}
                {{ line.name.value | default: 'Recovery' }} · {{ ppt }} pouches per tin
              {%- else -%}
                {% render 'pakd-ph', label: 'pouches per tin' %}
              {%- endif -%}
            </p>
            {%- if p -%}
              {%- render 'pakd-stars', rating: p.metafields.reviews.rating.value.rating, count: p.metafields.reviews.rating_count.value -%}
            {%- endif -%}
            {%- if p and p.available -%}
              {%- render 'pakd-buy-box', product: p, form_id: form_id, section_id: section.id, button_label: block.settings.button_label -%}
            {%- else -%}
              <p class="pakd-card__price">{% render 'pakd-ph', label: 'price' %}</p>
              {%- if p and section.settings.soldout == 'notify' -%}
                {%- form 'customer', id: form_id, class: 'pakd-bis' -%}
                  <input type="hidden" name="contact[tags]" value="back-in-stock,bis-{{ p.handle }}">
                  {%- if form.posted_successfully? -%}
                    <p class="pakd-form-success" role="status">Got it. We'll email you when it's back.</p>
                  {%- else -%}
                    <label class="visually-hidden" for="{{ form_id }}-email">Email address</label>
                    <input class="pakd-input" id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" placeholder="Email" required>
                    <button type="submit" class="pakd-btn pakd-btn--sm pakd-btn--ghost">Notify me</button>
                  {%- endif -%}
                {%- endform -%}
              {%- else -%}
                <button class="pakd-btn pakd-btn--block" disabled>{% if p %}Sold out{% else %}{{ block.settings.button_label | escape }}{% endif %}</button>
              {%- endif -%}
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
      </ul>
      <button type="button" class="pakd-carousel__btn pakd-carousel__btn--next" data-dir="1" aria-controls="Track-{{ section.id }}" aria-label="Next product">{% render 'pakd-icon', name: 'arrow' %}</button>
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="pakd-carousel__nav">
        <div class="pakd-carousel__dots">
          {%- for block in section.blocks -%}
            <button type="button" class="pakd-carousel__dot" data-index="{{ forloop.index0 }}" aria-label="Show product {{ forloop.index }} of {{ forloop.length }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
        <p class="pakd-carousel__count" aria-hidden="true"><span data-current>1</span> / {{ section.blocks.size }}</p>
      </div>
    {%- endif -%}
  </pakd-carousel>
  </div>
</section>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .pakd-carousel { display: block; }
  .pakd-carousel__stage { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1.6rem; }
  .pakd-carousel__btn {
    display: grid; place-items: center; width: 5.6rem; height: 5.6rem; border-radius: 50%;
    border: 2px solid var(--pakd-ink); background: var(--pakd-paper); color: var(--pakd-ink); cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease; z-index: 2;
  }
  .pakd-carousel__btn svg { width: 2.2rem; height: 2.2rem; }
  .pakd-carousel__btn--prev svg { transform: rotate(180deg); }
  .pakd-carousel__btn:hover { background: var(--recovery); transform: scale(1.05); }
  .pakd-carousel__btn:focus-visible { outline: 3px solid var(--pakd-ink); outline-offset: 3px; }

  .pakd-carousel__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: 100%;
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    list-style: none; margin: 0; padding: 0; scrollbar-width: none;
  }
  .pakd-carousel__track::-webkit-scrollbar { display: none; }
  .pakd-carousel__track:focus-visible { outline: 3px solid var(--pakd-ink); outline-offset: 4px; border-radius: var(--pakd-radius-lg); }

  .pakd-tin-slide {
    position: relative; scroll-snap-align: start; scroll-snap-stop: always;
    display: grid; gap: 2.4rem; align-items: center;
    padding: 2.4rem 1.6rem; border-radius: var(--pakd-radius-lg);
    background: var(--pakd-off);
  }
  @media screen and (min-width: 750px) {
    .pakd-tin-slide { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4.8rem; padding: 4.8rem; }
  }
  .pakd-tin-slide .pakd-card__badge { top: 2.4rem; left: 2.4rem; font-size: 1.2rem; padding: 0.7rem 1.2rem; }
  .pakd-tin-slide__circle {
    position: relative; display: grid; place-items: center;
    width: min(100%, 44rem); aspect-ratio: 1; margin: 0 auto;
    border-radius: 50%; overflow: hidden;
    background: var(--chip, var(--recovery));
    border: 3px solid var(--pakd-ink);
    box-shadow: 0 3.2rem 4.8rem -2.4rem rgba(10, 10, 10, 0.4), inset 0 0 0 1.6rem rgba(255, 255, 255, 0.28);
    text-decoration: none; color: var(--pakd-ink);
    transition: transform 0.4s ease;
  }
  .pakd-tin-slide:hover .pakd-tin-slide__circle { transform: rotate(-6deg); }
  .pakd-tin-slide__circle img { width: 100%; height: 100%; object-fit: cover; }
  .pakd-tin-slide__lid { font-family: var(--pakd-display); font-size: clamp(6.4rem, 12vw, 11rem); line-height: 1; letter-spacing: 0.02em; }
  .pakd-tin-slide__hint {
    position: absolute; bottom: 16%; left: 50%; transform: translateX(-50%);
    padding: 0.5rem 1.2rem; border-radius: 99rem; background: var(--pakd-paper);
    font: 600 1.2rem/1.3 var(--pakd-body); white-space: nowrap;
  }
  .pakd-tin-slide__body { display: flex; flex-direction: column; gap: 1rem; max-width: 52rem; min-width: 0; }
  .pakd-tin-slide__body .pakd-card__title { font-size: clamp(4.8rem, 8vw, 8rem); line-height: 0.9; }
  .pakd-tin-slide__body .pakd-card__title a { color: inherit; text-decoration: none; }
  .pakd-tin-slide__body .pakd-card__title a::after { content: none; }
  .pakd-tin-slide__body .pakd-card__meta { font-size: 1.6rem; }
  .pakd-tin-slide__body .pakd-card__price { font-size: 2.4rem; margin-bottom: 0.8rem; }
  .pakd-tin-slide__body .pakd-card__ppp { font-size: 1.4rem; }
  .pakd-tin-slide__body .pakd-btn { min-height: 5.6rem; font-size: 1.5rem; }

  .pakd-carousel__nav { display: flex; align-items: center; justify-content: center; gap: 1.6rem; margin-top: 2.4rem; }
  .pakd-carousel__dots { display: flex; gap: 0.4rem; }
  .pakd-carousel__dot { width: 2.8rem; height: 2.8rem; border: 0; background: none; padding: 0; cursor: pointer; display: grid; place-items: center; }
  .pakd-carousel__dot::before { content: ''; width: 1rem; height: 1rem; border-radius: 99rem; background: #c9c6bb; transition: width 0.2s ease, background 0.2s ease; }
  .pakd-carousel__dot[aria-current='true']::before { width: 2.4rem; background: var(--pakd-ink); }
  .pakd-carousel__dot:focus-visible { outline: 3px solid var(--pakd-ink); border-radius: 99rem; }
  .pakd-carousel__count { margin: 0; font: 600 1.3rem/1 var(--pakd-body); color: var(--pakd-muted); font-variant-numeric: tabular-nums; }

  @media screen and (max-width: 749px) {
    .pakd-carousel__stage { grid-template-columns: minmax(0, 1fr); }
    .pakd-carousel__btn { position: absolute; top: calc(2.4rem + min(100vw - 6.4rem, 44rem) / 2); transform: translateY(-50%); width: 4.8rem; height: 4.8rem; }
    .pakd-carousel__btn:hover { transform: translateY(-50%); }
    .pakd-carousel__btn--prev { left: 0.8rem; }
    .pakd-carousel__btn--next { right: 0.8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pakd-carousel__track { scroll-behavior: auto; }
    .pakd-tin-slide__circle, .pakd-carousel__btn, .pakd-carousel__dot::before { transition: none; }
    .pakd-tin-slide:hover .pakd-tin-slide__circle { transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('pakd-carousel')) {
    customElements.define('pakd-carousel', class extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.pakd-carousel__track');
        this.slides = Array.from(this.track.children);
        this.dots = Array.from(this.querySelectorAll('.pakd-carousel__dot'));
        this.current = this.querySelector('[data-current]');
        this.querySelectorAll('.pakd-carousel__btn').forEach((b) =>
          b.addEventListener('click', () => this.goTo(this.index() + Number(b.dataset.dir)))
        );
        this.dots.forEach((d) => d.addEventListener('click', () => this.goTo(Number(d.dataset.index))));
        this.track.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); this.goTo(this.index() + 1); }
          if (e.key === 'ArrowLeft') { e.preventDefault(); this.goTo(this.index() - 1); }
        });
        let t;
        this.track.addEventListener('scroll', () => { clearTimeout(t); t = setTimeout(() => this.update(), 60); }, { passive: true });
        document.addEventListener('shopify:block:select', (e) => {
          const k = this.slides.indexOf(e.target);
          if (k > -1) this.goTo(k);
        });
        this.update();
      }
      index() { return Math.round(this.track.scrollLeft / Math.max(1, this.track.clientWidth)); }
      goTo(i) {
        const n = this.slides.length;
        if (!n) return;
        const target = ((i % n) + n) % n;
        const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.track.scrollTo({ left: target * this.track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
        this.update(target);
      }
      update(i = this.index()) {
        this.dots.forEach((d, k) => d.setAttribute('aria-current', k === i ? 'true' : 'false'));
        if (this.current) this.current.textContent = i + 1;
        this.slides.forEach((s, k) => {
          s.inert = k !== i;
          s.setAttribute('aria-hidden', k === i ? 'false' : 'true');
        });
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "PAKD tin carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Recovery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "Shop all Recovery" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "select", "id": "soldout", "label": "Sold-out tins", "default": "notify", "options": [
      { "value": "notify", "label": "Show back-in-stock form" },
      { "value": "show", "label": "Show as sold out" }
    ] }
  ],
  "blocks": [
    { "type": "tin", "name": "Tin", "settings": [
      { "type": "image_picker", "id": "image", "label": "Tin image", "info": "Fills the circle. Use a square, top-down photo of the tin, at least 900 x 900px." },
      { "type": "product", "id": "product", "label": "Product", "info": "Adds live price, price per pouch, rating and add to cart." },
      { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the product's flavour name." },
      { "type": "text", "id": "text", "label": "Short line", "info": "Leave blank to show pouches per tin from Shopify." },
      { "type": "text", "id": "badge", "label": "Badge", "info": "e.g. Best seller or New. Leave blank for none." },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
      { "type": "color", "id": "circle_colour", "label": "Circle colour", "info": "Shows behind or instead of the image. Leave blank to use the product's flavour colour." }
    ] }
  ],
  "presets": [{ "name": "PAKD tin carousel", "blocks": [{ "type": "tin" }, { "type": "tin" }, { "type": "tin" }, { "type": "tin" }] }]
}
{% endschema %}
