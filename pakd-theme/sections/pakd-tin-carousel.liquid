{%- comment -%}
  3. Best sellers: scrollable carousel of tins.
  One block per tin. Everything is editable in the theme editor:
  - Tin image fills the circle (upload a square, top-down shot of the tin).
  - Title, short line, badge and button label are plain text settings.
  - Pick a product to pull in live price, price per pouch and add to cart.
    Price and pouch count always come from Shopify, never from typed text.
{%- endcomment -%}
<section class="pakd-section" aria-labelledby="Carousel-{{ section.id }}">
  <div class="pakd-wrap">
    <div class="pakd-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="pakd-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="pakd-h2" id="Carousel-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="pakd-lede">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      <div class="pakd-carousel__controls">
        {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
          <a class="pakd-link" href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_label | escape }}</a>
        {%- endif -%}
        <button type="button" class="pakd-carousel__btn" data-dir="-1" aria-controls="Track-{{ section.id }}" aria-label="Previous tins">{% render 'pakd-icon', name: 'arrow' %}</button>
        <button type="button" class="pakd-carousel__btn" data-dir="1" aria-controls="Track-{{ section.id }}" aria-label="Next tins">{% render 'pakd-icon', name: 'arrow' %}</button>
      </div>
    </div>
  </div>

  <pakd-carousel class="pakd-carousel" style="--per-view: {{ section.settings.per_view }}">
    <ul class="pakd-carousel__track" id="Track-{{ section.id }}" role="list" tabindex="0" aria-label="{{ section.settings.heading | escape }}, scroll for more">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign variant = p.selected_or_first_available_variant
          assign line = p.metafields.pakd.line.value
          assign ppt = line.pouches_per_tin.value
          assign tins = variant.metafields.pakd.tins.value | default: 1
          assign pouches = nil
          if ppt != blank
            assign pouches = ppt | times: tins
          endif
          assign colour = block.settings.circle_colour
          if colour == blank
            assign colour = p.metafields.pakd.flavour_colour.value | default: '#B8F33A'
          endif
          assign title = block.settings.title
          if title == blank
            assign title = p.metafields.pakd.flavour.value | default: p.title
          endif
          assign form_id = 'pakd-tin-' | append: section.id | append: '-' | append: block.id
        -%}
        <li class="pakd-tin-slide" style="--chip: {{ colour }}" aria-label="{{ forloop.index }} of {{ forloop.length }}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}
            <span class="pakd-card__badge">{{ block.settings.badge | escape }}</span>
          {%- elsif p and p.available == false -%}
            <span class="pakd-card__badge">Sold out</span>
          {%- endif -%}

          {%- capture circle -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 990px) 28vw, 70vw',
                alt: block.settings.image.alt | default: title
              }}
            {%- else -%}
              <span class="pakd-tin-slide__lid" aria-hidden="true">PAKD</span>
              {%- if request.design_mode -%}<span class="pakd-tin-slide__hint">Upload tin image</span>{%- endif -%}
            {%- endif -%}
          {%- endcapture -%}
          {%- if p -%}
            <a class="pakd-tin-slide__circle" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{{ circle }}</a>
          {%- else -%}
            <div class="pakd-tin-slide__circle">{{ circle }}</div>
          {%- endif -%}

          <div class="pakd-tin-slide__body">
            <h3 class="pakd-card__title">
              {%- if p -%}<a href="{{ p.url }}">{{ title | escape }}</a>{%- else -%}{{ title | default: 'Tin name' | escape }}{%- endif -%}
            </h3>
            <p class="pakd-card__meta">
              {%- if block.settings.text != blank -%}
                {{ block.settings.text | escape }}
              {%- elsif pouches -%}
                {{ line.name.value | default: 'Recovery' }} · {{ pouches }} pouches
              {%- else -%}
                {% render 'pakd-ph', label: 'pouches per tin' %}
              {%- endif -%}
            </p>
            {%- if p -%}
              {%- render 'pakd-stars', rating: p.metafields.reviews.rating.value.rating, count: p.metafields.reviews.rating_count.value -%}
            {%- endif -%}
            <p class="pakd-card__price">
              {%- if p and variant.price > 0 -%}
                <span>{{ variant.price | money }}</span>
                {%- if pouches and pouches > 0 -%}
                  {%- assign ppp = variant.price | times: 1.0 | divided_by: pouches | round -%}
                  <span class="pakd-card__ppp">{{ ppp | money }} per pouch</span>
                {%- endif -%}
              {%- else -%}
                {% render 'pakd-ph', label: 'price' %}
              {%- endif -%}
            </p>

            {%- if p and p.available -%}
              <product-form class="product-form" data-section-id="{{ section.id }}">
                <div class="product-form__error-message-wrapper" role="alert" hidden>
                  <span class="product-form__error-message"></span>
                </div>
                {%- form 'product', p, id: form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                  <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
                  <button type="submit" name="add" class="pakd-btn pakd-btn--sm pakd-btn--block" aria-label="{{ block.settings.button_label | escape }}: {{ title | escape }}">
                    <span>{{ block.settings.button_label | escape }}</span>
                    {%- render 'loading-spinner' -%}
                  </button>
                {%- endform -%}
              </product-form>
            {%- elsif p and section.settings.soldout == 'notify' -%}
              {%- form 'customer', id: form_id, class: 'pakd-bis' -%}
                <input type="hidden" name="contact[tags]" value="back-in-stock,bis-{{ p.handle }}">
                {%- if form.posted_successfully? -%}
                  <p class="pakd-form-success" role="status">Got it. We'll email you when it's back.</p>
                {%- else -%}
                  <label class="visually-hidden" for="{{ form_id }}-email">Email address</label>
                  <input class="pakd-input" id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" placeholder="Email" required>
                  <button type="submit" class="pakd-btn pakd-btn--sm pakd-btn--ghost">Notify me</button>
                {%- endif -%}
              {%- endform -%}
            {%- else -%}
              <button class="pakd-btn pakd-btn--sm pakd-btn--block" disabled>{% if p %}Sold out{% else %}{{ block.settings.button_label | escape }}{% endif %}</button>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </pakd-carousel>
</section>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .pakd-carousel { display: block; }
  .pakd-carousel__controls { display: flex; align-items: center; gap: 0.8rem; }
  .pakd-carousel__controls .pakd-link { margin-right: 0.8rem; }
  .pakd-carousel__btn {
    display: grid; place-items: center; width: 4.8rem; height: 4.8rem; border-radius: 50%;
    border: 1.5px solid var(--pakd-ink); background: var(--pakd-paper); color: var(--pakd-ink); cursor: pointer;
  }
  .pakd-carousel__btn svg { width: 2rem; height: 2rem; }
  .pakd-carousel__btn[data-dir='-1'] svg { transform: rotate(180deg); }
  .pakd-carousel__btn:hover:not([disabled]) { background: var(--recovery); }
  .pakd-carousel__btn[disabled] { opacity: 0.35; cursor: default; }
  .pakd-carousel__btn:focus-visible { outline: 3px solid var(--pakd-ink); outline-offset: 3px; }

  .pakd-carousel__track {
    --gap: 1.2rem;
    display: grid; grid-auto-flow: column; gap: var(--gap);
    grid-auto-columns: 72%;
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    list-style: none; margin: 0;
    padding-block: 0.4rem 1.6rem;
    padding-left: max(var(--pakd-gutter), env(safe-area-inset-left, 0px));
    padding-right: max(var(--pakd-gutter), env(safe-area-inset-right, 0px));
    scroll-padding-inline: max(var(--pakd-gutter), env(safe-area-inset-left, 0px));
    scrollbar-width: thin;
  }
  .pakd-carousel__track:focus-visible { outline: 3px solid var(--pakd-ink); outline-offset: -3px; }
  @media screen and (min-width: 750px) { .pakd-carousel__track { --gap: 2rem; grid-auto-columns: calc((100% - var(--pakd-gutter) * 2 - var(--gap) * 2) / 2.5); } }
  @media screen and (min-width: 1200px) {
    .pakd-carousel__track {
      grid-auto-columns: calc((min(100vw, 128rem) - var(--pakd-gutter) * 2 - var(--gap) * (var(--per-view) - 1)) / var(--per-view));
      padding-left: max(var(--pakd-gutter), calc((100vw - 128rem) / 2 + var(--pakd-gutter)));
      scroll-padding-inline: max(var(--pakd-gutter), calc((100vw - 128rem) / 2 + var(--pakd-gutter)));
    }
  }

  .pakd-tin-slide {
    position: relative; scroll-snap-align: start;
    display: flex; flex-direction: column; gap: 1.6rem;
    padding: 2rem; border-radius: var(--pakd-radius-lg);
    background: var(--pakd-off); border: 1.5px solid var(--pakd-line);
  }
  .pakd-tin-slide .pakd-card__badge { top: 2rem; left: 2rem; }
  .pakd-tin-slide__circle {
    position: relative; display: grid; place-items: center;
    width: 86%; max-width: 100%; aspect-ratio: 1; margin: 0.8rem auto 0;
    border-radius: 50%; overflow: hidden;
    background: var(--chip, var(--recovery));
    border: 3px solid var(--pakd-ink);
    box-shadow: 0 2.4rem 3.2rem -1.6rem rgba(10, 10, 10, 0.35), inset 0 0 0 1.2rem rgba(255, 255, 255, 0.28);
    text-decoration: none; color: var(--pakd-ink);
    transition: transform 0.25s ease;
  }
  .pakd-tin-slide:hover .pakd-tin-slide__circle { transform: rotate(-6deg) scale(1.02); }
  .pakd-tin-slide__circle img { width: 100%; height: 100%; object-fit: cover; }
  .pakd-tin-slide__lid { font-family: var(--pakd-display); font-size: clamp(4.8rem, 9vw, 8rem); line-height: 1; letter-spacing: 0.02em; }
  .pakd-tin-slide__hint {
    position: absolute; bottom: 16%; left: 50%; transform: translateX(-50%);
    padding: 0.4rem 1rem; border-radius: 99rem; background: var(--pakd-paper);
    font: 600 1.1rem/1.3 var(--pakd-body); white-space: nowrap;
  }
  .pakd-tin-slide__body { display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
  .pakd-tin-slide__body .pakd-card__title { font-size: 3.2rem; }
  .pakd-tin-slide__body .pakd-card__title a::after { content: none; }
  .pakd-tin-slide__body form, .pakd-tin-slide__body > .pakd-btn { margin-top: auto; padding-top: 0.8rem; }
  .pakd-tin-slide__body > .pakd-btn { margin-top: auto; }
  @media (prefers-reduced-motion: reduce) {
    .pakd-carousel__track { scroll-behavior: auto; }
    .pakd-tin-slide__circle { transition: none; }
    .pakd-tin-slide:hover .pakd-tin-slide__circle { transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('pakd-carousel')) {
    customElements.define('pakd-carousel', class extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.pakd-carousel__track');
        const section = this.closest('section');
        this.buttons = section ? section.querySelectorAll('.pakd-carousel__btn') : [];
        this.buttons.forEach((b) => b.addEventListener('click', () => this.go(Number(b.dataset.dir))));
        this.track.addEventListener('scroll', () => this.update(), { passive: true });
        this.track.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); this.go(1); }
          if (e.key === 'ArrowLeft') { e.preventDefault(); this.go(-1); }
        });
        window.addEventListener('resize', () => this.update());
        this.update();
      }
      step() {
        const slide = this.track.querySelector('.pakd-tin-slide');
        if (!slide) return 0;
        return slide.getBoundingClientRect().width + parseFloat(getComputedStyle(this.track).columnGap || 0);
      }
      go(dir) { this.track.scrollBy({ left: dir * this.step(), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); }
      update() {
        const max = this.track.scrollWidth - this.track.clientWidth - 2;
        this.buttons.forEach((b) => {
          const dir = Number(b.dataset.dir);
          b.disabled = dir < 0 ? this.track.scrollLeft <= 2 : this.track.scrollLeft >= max;
        });
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "PAKD tin carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Recovery" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "Shop all Recovery" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "select", "id": "per_view", "label": "Tins visible on desktop", "default": "3.5", "options": [
      { "value": "3", "label": "3" }, { "value": "3.5", "label": "3.5 (hints there's more)" }, { "value": "4", "label": "4" }
    ] },
    { "type": "select", "id": "soldout", "label": "Sold-out tins", "default": "notify", "options": [
      { "value": "notify", "label": "Show back-in-stock form" },
      { "value": "show", "label": "Show as sold out" }
    ] }
  ],
  "blocks": [
    { "type": "tin", "name": "Tin", "settings": [
      { "type": "image_picker", "id": "image", "label": "Tin image", "info": "Fills the circle. Use a square, top-down photo of the tin, at least 900 x 900px." },
      { "type": "product", "id": "product", "label": "Product", "info": "Adds live price, price per pouch, rating and add to cart." },
      { "type": "text", "id": "title", "label": "Title", "info": "Leave blank to use the product's flavour name." },
      { "type": "text", "id": "text", "label": "Short line", "info": "Leave blank to show the line and pouch count from Shopify." },
      { "type": "text", "id": "badge", "label": "Badge", "info": "e.g. Best seller or New. Leave blank for none." },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
      { "type": "color", "id": "circle_colour", "label": "Circle colour", "info": "Shows behind or instead of the image. Leave blank to use the product's flavour colour." }
    ] }
  ],
  "presets": [{ "name": "PAKD tin carousel", "blocks": [{ "type": "tin" }, { "type": "tin" }, { "type": "tin" }, { "type": "tin" }] }]
}
{% endschema %}
