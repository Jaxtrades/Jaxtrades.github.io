{%- comment -%} 5. How to use in three steps. Upload an image/GIF per step, or the built-in illustration shows. {%- endcomment -%}
<section class="pakd-section" aria-labelledby="HowTo-{{ section.id }}">
  <div class="pakd-wrap">
    <div class="pakd-head">
      <div>
        <p class="pakd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="pakd-h2" id="HowTo-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>
    <ol class="pakd-steps" role="list">
      {%- for block in section.blocks -%}
        <li class="pakd-step" {{ block.shopify_attributes }}>
          <div class="pakd-step__art">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 30vw, 80vw', alt: block.settings.image.alt | default: block.settings.title }}
            {%- else -%}
              {%- render 'pakd-step-art', step: forloop.index -%}
            {%- endif -%}
          </div>
          <p class="pakd-step__num">Step {{ forloop.index }}</p>
          <h3 class="pakd-step__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="pakd-step__text">{{ block.settings.text | escape }}</p>
          {%- else -%}
            <p class="pakd-step__text">{% render 'pakd-ph', label: 'step wording from label directions' %}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.link != blank -%}
      <p class="pakd-form-note"><a class="pakd-link" href="{{ section.settings.link }}">Full directions and warnings</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PAKD how to use",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps. That's it." },
    { "type": "url", "id": "link", "label": "Directions link", "info": "Point to the product page 'What's in it' panel or FAQ." }
  ],
  "max_blocks": 3,
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text", "info": "Keep it short. Must match the label directions." },
      { "type": "image_picker", "id": "image", "label": "Image or GIF (optional)" }
    ] }
  ],
  "presets": [{ "name": "PAKD how to use" }]
}
{% endschema %}
