{%- comment -%}
  10. Email/SMS signup with first-order incentive (Theme settings > PAKD facts > signup offer).
  Native form captures email. For SMS with compliant consent, add Shopify Forms
  (or Klaviyo) as an app block; it then replaces the native form.
{%- endcomment -%}
{%- liquid
  assign has_app_block = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}
<section class="pakd-section pakd-section--ink" id="signup" aria-labelledby="Signup-{{ section.id }}">
  <div class="pakd-wrap pakd-signup">
    <div>
      <p class="pakd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="pakd-h2" id="Signup-{{ section.id }}">
        {{ section.settings.heading | escape }}
        <span class="pakd-signup__offer" style="display:block">
          {%- if settings.fact_signup_offer != blank -%}{{ settings.fact_signup_offer | escape }}{%- else -%}{% render 'pakd-ph', label: 'first-order offer' %}{%- endif -%}
        </span>
      </h2>
      <p class="pakd-lede">{{ section.settings.text | escape }}</p>
    </div>
    <div>
      {%- if has_app_block -%}
        {%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}
      {%- else -%}
        {%- form 'customer', id: 'pakd-signup-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,signup-homepage">
          {%- if form.posted_successfully? -%}
            <p class="pakd-form-success" role="status">You're in. Check your inbox.</p>
          {%- else -%}
            <div class="pakd-field">
              <label class="visually-hidden" for="pakd-signup-email">Email address</label>
              <input class="pakd-input" id="pakd-signup-email" type="email" name="contact[email]" autocomplete="email" placeholder="Your email" required
                {% if form.errors %}aria-invalid="true" aria-describedby="pakd-signup-error"{% endif %}>
              <button class="pakd-btn pakd-btn--accent" type="submit">Sign up</button>
            </div>
            {%- if form.errors -%}
              <p class="pakd-form-note" id="pakd-signup-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
            <p class="pakd-form-note">Email only for now. Unsubscribe anytime. See our <a class="pakd-link" href="{{ shop.privacy_policy.url }}">Privacy Policy</a>.</p>
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PAKD signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join PAKD" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get first dibs." },
    { "type": "text", "id": "text", "label": "Text", "default": "New flavours, new lines and members-only drops. No spam." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "PAKD signup" }]
}
{% endschema %}
