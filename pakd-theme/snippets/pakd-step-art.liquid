{%- comment -%} Simple placeholder illustrations for the how-to steps. Param: step (1-3) {%- endcomment -%}
<svg viewBox="0 0 200 150" aria-hidden="true" focusable="false">
{%- case step -%}
  {%- when 1 -%}
    <ellipse cx="100" cy="110" rx="70" ry="22" fill="#0A0A0A" opacity=".12"/>
    <ellipse cx="100" cy="98" rx="70" ry="24" fill="#B8F33A" stroke="#0A0A0A" stroke-width="3"/>
    <path d="M30 98v-10M170 98v-10" stroke="#0A0A0A" stroke-width="3"/>
    <ellipse cx="100" cy="88" rx="70" ry="24" fill="#FFFFFF" stroke="#0A0A0A" stroke-width="3"/>
    <g transform="rotate(-18 120 40)"><ellipse cx="120" cy="40" rx="66" ry="20" fill="#B8F33A" stroke="#0A0A0A" stroke-width="3"/></g>
  {%- when 2 -%}
    <rect x="62" y="50" width="76" height="40" rx="14" fill="#FFFFFF" stroke="#0A0A0A" stroke-width="3"/>
    <path d="M78 70h44" stroke="#0A0A0A" stroke-width="3" stroke-dasharray="4 6"/>
    <path d="M100 98v26M88 112l12 12 12-12" fill="none" stroke="#0A0A0A" stroke-width="3" stroke-linecap="round"/>
  {%- else -%}
    <circle cx="100" cy="72" r="46" fill="#B8F33A" stroke="#0A0A0A" stroke-width="3"/>
    <path d="M76 66h0M124 66h0" stroke="#0A0A0A" stroke-width="10" stroke-linecap="round"/>
    <path d="M78 86c12 14 32 14 44 0" fill="none" stroke="#0A0A0A" stroke-width="4" stroke-linecap="round"/>
    <path d="M150 120h30M160 110l20 10-20 10" fill="none" stroke="#0A0A0A" stroke-width="3" stroke-linecap="round"/>
{%- endcase -%}
</svg>
