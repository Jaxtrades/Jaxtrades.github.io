<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width narrow center">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte" style="color: var(--color-muted); font-size: 1.1rem;">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <a class="button mt-2" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share your story with customers.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "surface", "label": "Use panel background", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
