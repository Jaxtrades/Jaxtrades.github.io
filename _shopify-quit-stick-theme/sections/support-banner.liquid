<section class="section section--tight">
  <div class="page-width">
    <div class="support">
      <div style="display: flex; gap: 1rem; align-items: center;">
        <div class="card__icon" style="margin: 0;">{% render 'icon', name: 'phone' %}</div>
        <div>
          <h3>{{ section.settings.heading }}</h3>
          <p>{{ section.settings.text }}</p>
        </div>
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Support banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You don't have to do it alone" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Call Quitline on 13 7848 for free, confidential support from trained counsellors across Australia."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Visit quit.org.au" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "https://www.quit.org.au" }
  ],
  "presets": [{ "name": "Support banner" }]
}
{% endschema %}
