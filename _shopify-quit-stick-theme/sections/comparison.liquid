<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width" style="max-width: 920px;">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="compare-wrap">
      <table class="compare">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{{ 'sections.comparison.feature' | t }}</span></th>
            <th scope="col" class="is-us">{{ section.settings.col_1 }}</th>
            <th scope="col">{{ section.settings.col_2 }}</th>
            <th scope="col">{{ section.settings.col_3 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.feature }}</td>
              {%- assign cols = 'us,col_2,col_3' | split: ',' -%}
              {%- for col in cols -%}
                {%- assign value = block.settings[col] -%}
                <td{% if forloop.first %} class="is-us"{% endif %}>
                  {%- if value -%}
                    <span class="yes">{% render 'icon', name: 'check' %}</span><span class="visually-hidden">{{ 'general.yes' | t }}</span>
                  {%- else -%}
                    <span class="no">{% render 'icon', name: 'cross' %}</span><span class="visually-hidden">{{ 'general.no' | t }}</span>
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Quit Stick stacks up" },
    { "type": "text", "id": "col_1", "label": "Column 1 (you)", "default": "Quit Stick" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Cigarettes" },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Vapes" },
    { "type": "checkbox", "id": "surface", "label": "Use panel background", "default": true }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Feature" },
        { "type": "checkbox", "id": "us", "label": "Column 1 has it", "default": true },
        { "type": "checkbox", "id": "col_2", "label": "Column 2 has it", "default": false },
        { "type": "checkbox", "id": "col_3", "label": "Column 3 has it", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "feature": "Nicotine-free", "us": true, "col_2": false, "col_3": false } },
        { "type": "row", "settings": { "feature": "No smoke or vapour", "us": true, "col_2": false, "col_3": false } },
        { "type": "row", "settings": { "feature": "No battery or charging", "us": true, "col_2": true, "col_3": false } },
        { "type": "row", "settings": { "feature": "Hand-to-mouth ritual", "us": true, "col_2": true, "col_3": true } },
        { "type": "row", "settings": { "feature": "Fine to use indoors", "us": true, "col_2": false, "col_3": false } }
      ]
    }
  ]
}
{% endschema %}
