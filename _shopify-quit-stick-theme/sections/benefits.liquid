<section class="section{% if section.settings.surface %} section--surface{% endif %}" id="benefits">
  <div class="page-width">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="grid grid--{{ section.blocks.size | at_most: 4 | at_least: 2 }}">
      {%- for block in section.blocks -%}
        <div class="card" {{ block.shopify_attributes }}>
          <div class="card__icon">{% render 'icon', name: block.settings.icon %}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you miss. Nothing you don't." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Cravings are as much about the habit as the chemical. Quit Stick gives your hands and your breath something familiar to do."
    },
    { "type": "checkbox", "id": "surface", "label": "Use panel background", "default": false }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "no-nicotine", "label": "No nicotine" },
            { "value": "wind", "label": "Air" },
            { "value": "battery-off", "label": "No battery" },
            { "value": "pocket", "label": "Pocket" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "hand", "label": "Hand" },
            { "value": "truck", "label": "Truck" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the benefit." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "no-nicotine", "title": "No nicotine", "text": "Flavoured air only, so there's no new habit to break later." } },
        { "type": "benefit", "settings": { "icon": "wind", "title": "No vapour, no smoke", "text": "Nothing is heated or burned. Use it anywhere you like." } },
        { "type": "benefit", "settings": { "icon": "battery-off", "title": "No electronics", "text": "No battery, no coil, no charging cable. Nothing to break." } },
        { "type": "benefit", "settings": { "icon": "pocket", "title": "Pocket sized", "text": "100 mm long, about the length of a cigarette." } }
      ]
    }
  ]
}
{% endschema %}
