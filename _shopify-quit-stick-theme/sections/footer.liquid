<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        <div class="site-footer__about rte">{{ section.settings.about }}</div>
        <div class="social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          {%- endif -%}
        </div>
      </div>

      <div>
        <h3>{{ section.settings.menu_1.title | default: 'Shop' }}</h3>
        <ul>
          {%- for link in section.settings.menu_1.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}">{{ 'general.shop_all' | t }}</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div>
        <h3>{{ section.settings.menu_2.title | default: 'Help' }}</h3>
        <ul>
          {%- for link in section.settings.menu_2.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- else -%}
            <li><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <div class="site-footer__disclaimer rte">{{ section.settings.disclaimer }}</div>
    {%- endif -%}

    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span>
      <span>{{ powered_by_link }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keep the ritual. Drop the cigarette." },
    {
      "type": "richtext",
      "id": "about",
      "label": "About text",
      "default": "<p>A hand-finished wooden inhaler that delivers nothing but naturally flavoured air. Made for adults who want to quit smoking or vaping.</p>"
    },
    { "type": "link_list", "id": "menu_1", "label": "First menu", "default": "main-menu" },
    { "type": "link_list", "id": "menu_2", "label": "Second menu", "default": "footer" },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>Quit Stick is not a therapeutic good or medical device and is not intended to diagnose, treat, cure or prevent any condition. It contains no nicotine or tobacco. For adults only. For free quitting support in Australia, call Quitline on 13 7848.</p>"
    }
  ]
}
{% endschema %}
