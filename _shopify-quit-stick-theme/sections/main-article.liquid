<article class="page-width narrow" style="padding-bottom: clamp(56px, 8vw, 112px);">
  <div class="page-head">
    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" class="eyebrow">{{ article.published_at | date: format: 'date' }}</time>
    <h1>{{ article.title }}</h1>
  </div>
  {%- if article.image -%}
    <div style="margin-bottom: 2rem; border-radius: var(--radius); overflow: hidden;">
      {{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 800px) 760px, 100vw', alt: article.title }}
    </div>
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <p class="mt-2"><a href="{{ blog.url }}">&larr; {{ 'blogs.back' | t: title: blog.title }}</a></p>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
