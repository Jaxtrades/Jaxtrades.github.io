<div class="page-width" style="padding-bottom: clamp(56px, 8vw, 112px);">
  <div class="page-head">
    <h1>{{ 'cart.title' | t }}</h1>
  </div>

  <div class="cart-page">
    {%- if cart.item_count > 0 -%}
      {% render 'shipping-bar' %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <ul class="cart-items">
          {%- for item in cart.items -%}
            {% render 'cart-line', item: item %}
          {%- endfor -%}
        </ul>

        <div class="cart-summary">
          {%- if section.settings.show_note -%}
            <div class="field">
              <label for="CartNote">{{ 'cart.note' | t }}</label>
              <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-summary__row" style="font-size: 1rem; font-weight: 500;">
              <span>{{ discount.title }}</span><span>-{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="cart-summary__row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <small>{{ 'cart.taxes_and_shipping' | t }}</small>
          <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}
            <div class="mt-2">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </form>
    {%- else -%}
      <div class="center">
        <p>{{ 'cart.empty_text' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": false }
  ]
}
{% endschema %}
