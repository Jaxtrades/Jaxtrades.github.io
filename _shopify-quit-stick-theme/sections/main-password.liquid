<div class="page-width center" style="min-height: 100vh; display: grid; place-items: center; padding: 48px 16px;">
  <div style="max-width: 520px;">
    <span class="logo-mark" style="display: inline-block; margin-bottom: 1.5rem;" aria-hidden="true"></span>
    <h1>{{ shop.name | capitalize }}</h1>
    {%- if shop.password_message != blank -%}
      <p style="color: var(--color-muted); font-size: 1.15rem;">{{ shop.password_message }}</p>
    {%- else -%}
      <p style="color: var(--color-muted); font-size: 1.15rem;">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="notice" role="status">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__form">
          <label for="PasswordEmail" class="visually-hidden">{{ 'sections.newsletter.email' | t }}</label>
          <input id="PasswordEmail" type="email" name="contact[email]" required placeholder="{{ 'sections.newsletter.email' | t }}">
          <button type="submit" class="button">{{ 'password.notify' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="mt-2">
      <summary style="cursor: pointer;">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<div class="errors mt-2">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="newsletter__form">
          <label for="StorePassword" class="visually-hidden">{{ 'password.password' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="button button--secondary">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Something new is on the way. Leave your email and we'll let you know when we open." }
  ]
}
{% endschema %}
