{%- paginate blog.articles by 9 -%}
  <div class="page-width" style="padding-bottom: clamp(56px, 8vw, 112px);">
    <div class="page-head">
      <span class="eyebrow">{{ 'blogs.eyebrow' | t }}</span>
      <h1>{{ blog.title }}</h1>
    </div>
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <a class="article-card" href="{{ article.url }}">
          {%- if article.image -%}
            {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', alt: article.title }}
          {%- endif -%}
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
          <h3 style="margin-top: 0.4rem;">{{ article.title }}</h3>
          <p style="color: var(--color-muted);">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
        </a>
      {%- else -%}
        <p class="center" style="grid-column: 1 / -1;">{{ 'blogs.empty' | t }}</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
