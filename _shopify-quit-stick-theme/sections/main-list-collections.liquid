<div class="page-width" style="padding-bottom: clamp(56px, 8vw, 112px);">
  <div class="page-head">
    <h1>{{ 'collections.all_title' | t }}</h1>
  </div>
  <div class="grid grid--3">
    {%- for collection in collections -%}
      <a class="product-card" href="{{ collection.url }}">
        <div class="product-card__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', alt: collection.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="product-card__title">{{ collection.title }}</div>
        <div class="product-card__price">{{ 'collections.product_count' | t: count: collection.products_count }}</div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
