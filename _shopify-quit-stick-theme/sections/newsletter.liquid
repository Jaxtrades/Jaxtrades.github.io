<section class="section section--primary">
  <div class="page-width newsletter">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <p style="opacity: 0.85;">{{ section.settings.text }}</p>
    {%- form 'customer', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'sections.newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="form-message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <div class="newsletter__form">
          <label for="NewsletterEmail" class="visually-hidden">{{ 'sections.newsletter.email' | t }}</label>
          <input id="NewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'sections.newsletter.email' | t }}">
          <button type="submit" class="button button--light">{{ section.settings.button_label }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay on track" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tips for your first smoke-free month" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join the list for practical tips, refill reminders and first dibs on new flavours." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
