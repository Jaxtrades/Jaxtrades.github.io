<section class="section{% if section.settings.surface %} section--surface{% endif %}" id="how-it-works">
  <div class="page-width">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="grid grid--{{ section.blocks.size | at_most: 4 | at_least: 2 }} steps">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 960px) 33vw, 100vw' }}
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p style="color: var(--color-muted);">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps. Ten seconds." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "No charging, no settings, no learning curve." },
    { "type": "checkbox", "id": "surface", "label": "Use panel background", "default": false }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this step." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Prep", "text": "Take a flavour core from the pack and fray the end with your fingers to open up the fibres." } },
        { "type": "step", "settings": { "title": "Insert", "text": "Slide the core into the wooden body." } },
        { "type": "step", "settings": { "title": "Inhale", "text": "Draw on it whenever a craving hits. Cover the small hole at the base to tighten the airflow." } }
      ]
    }
  ]
}
{% endschema %}
