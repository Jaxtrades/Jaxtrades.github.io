{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} gift card</title>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-width center" style="padding: 80px 16px;">
      <span class="eyebrow">{{ shop.name }}</span>
      <h1>{{ gift_card.initial_value | money }} gift card</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="errors">This gift card is no longer valid.</p>
      {%- endif -%}
      <div class="card" style="max-width: 420px; margin: 2rem auto;">
        <p>Code</p>
        <h2 style="letter-spacing: 0.08em;">{{ gift_card.code | format_code }}</h2>
        <p>Balance: {{ gift_card.balance | money }}</p>
        {%- if gift_card.expires_on -%}<p>Expires {{ gift_card.expires_on | date: format: 'date' }}</p>{%- endif -%}
      </div>
      <a class="button" href="{{ shop.url }}">Shop now</a>
      <p class="mt-2"><button class="link-button" onclick="window.print()">Print</button></p>
    </main>
  </body>
</html>
