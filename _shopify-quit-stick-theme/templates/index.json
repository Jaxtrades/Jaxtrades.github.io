    "faq": {
      "type": "faq",
      "blocks": {
        "q-1": { "type": "question", "settings": { "question": "Is there any nicotine in it?", "answer": "<p>No. Quit Stick contains no nicotine or tobacco. You're breathing in naturally flavoured air, nothing else.</p>" } },
        "q-2": { "type": "question", "settings": { "question": "Does it produce vapour or smoke?", "answer": "<p>No. Nothing is heated or burned, so there's no vapour, no smoke and no smell.</p>" } },
        "q-3": { "type": "question", "settings": { "question": "How long does a flavour core last?", "answer": "<p>Most people get a few days out of a single core. Every starter kit comes with 15 cores, and refill packs are available any time.</p>" } },
        "q-4": { "type": "question", "settings": { "question": "Do I need to charge it?", "answer": "<p>No. There's no battery, no coil and no cable. Just insert a core and go.</p>" } },
        "q-5": { "type": "question", "settings": { "question": "Will it help me quit?", "answer": "<p>Quit Stick is not a therapeutic good or medical device. Many people like keeping the hand-to-mouth habit while they cut back. For free, professional support in Australia, call Quitline on 13 7848.</p>" } },
        "q-6": { "type": "question", "settings": { "question": "Who can buy it?", "answer": "<p>Quit Stick is for adults only.</p>" } }
