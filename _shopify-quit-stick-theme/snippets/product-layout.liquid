{%- comment -%}
  Gallery + buy box shared by the product page and the featured product section.
  Usage: {% render 'product-layout', product: product, section: section, heading_tag: 'h1', update_url: true %}
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
-%}
<div class="product" data-product data-update-url="{{ update_url | default: false }}">
  <script type="application/json" data-product-json>
    {"currency": {{ cart.currency.iso_code | json }}, "variants": {{ product.variants | json }}}
  </script>

  <div class="product-gallery">
    <div class="product-gallery__main">
      {%- if featured -%}
        {{ featured | image_url: width: 1400 | image_tag:
          loading: 'eager',
          widths: '600, 900, 1200, 1400',
          sizes: '(min-width: 900px) 55vw, 100vw',
          alt: featured.alt | default: product.title,
          class: 'js-main-image'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="product-gallery__thumbs">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <button
              type="button"
              data-thumb
              data-media-id="{{ media.id }}"
              data-src="{{ media | image_url: width: 1400 }}"
              data-alt="{{ media.alt | default: product.title | escape }}"
              aria-current="{% if media.id == featured.id %}true{% else %}false{% endif %}"
              aria-label="{{ 'products.product.view_image' | t: number: forloop.index }}"
            >
              {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-info">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if heading_tag == 'h1' -%}
      <h1>{{ product.title }}</h1>
    {%- else -%}
      <h2 class="h1"><a href="{{ product.url }}" style="text-decoration: none;">{{ product.title }}</a></h2>
    {%- endif -%}

    <div class="price">
      <span data-price>{{ current_variant.price | money }}</span>
      <s data-compare-price {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
        {%- if current_variant.compare_at_price > current_variant.price -%}{{ current_variant.compare_at_price | money }}{%- endif -%}
      </s>
    </div>

    {%- form 'product', product, id: form_id, data-product-form: 'true' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="option" data-option-group>
            <legend>{{ option.name }}: <span data-selected-value>{{ option.selected_value }}</span></legend>
            <div class="option__values">
              {%- for value in option.values -%}
                {%- capture input_id -%}{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}{%- endcapture -%}
                {%- assign option_handle = option.name | handle -%}
                {%- assign use_swatch = false -%}
                {%- if option_handle contains 'finish' or option_handle contains 'colour' or option_handle contains 'color' -%}
                  {%- assign use_swatch = true -%}
                {%- endif -%}
                <input
                  type="radio"
                  id="{{ input_id }}"
                  name="option-{{ section.id }}-{{ option.position }}"
                  value="{{ value | escape }}"
                  data-option
                  {% if option.selected_value == value %}checked{% endif %}
                >
                <label for="{{ input_id }}"{% unless use_swatch %} class="no-swatch"{% endunless %}>
                  {%- if use_swatch -%}
                    <span class="swatch" style="background: {% render 'swatch-color', value: value %}"></span>
                  {%- endif -%}
                  {{ value }}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      <div class="buy-row">
        <div class="quantity">
          <button type="button" data-qty="minus" aria-label="{{ 'cart.decrease' | t }}">&minus;</button>
          <input type="number" name="quantity" min="1" value="1" aria-label="{{ 'cart.quantity' | t }}">
          <button type="button" data-qty="plus" aria-label="{{ 'cart.increase' | t }}">+</button>
        </div>
        <button type="submit" class="button" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
          <span>
            {%- if current_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
        </button>
      </div>
      <p class="errors" data-form-error hidden role="alert"></p>
      {%- if section.settings.show_dynamic_checkout -%}
        {{ form | payment_button }}
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.show_perks -%}
      <ul class="product-perks">
        {%- if section.settings.perk_1 != blank -%}<li>{% render 'icon', name: 'no-nicotine' %}{{ section.settings.perk_1 }}</li>{%- endif -%}
        {%- if section.settings.perk_2 != blank -%}<li>{% render 'icon', name: 'truck' %}{{ section.settings.perk_2 }}</li>{%- endif -%}
        {%- if section.settings.perk_3 != blank -%}<li>{% render 'icon', name: 'refresh' %}{{ section.settings.perk_3 }}</li>{%- endif -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_description and product.description != blank -%}
      <div class="product-description rte">{{ product.description }}</div>
    {%- endif -%}
  </div>
</div>
