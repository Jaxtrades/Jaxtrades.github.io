{%- comment -%}
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
<a class="product-card" href="{{ product.url }}">
  <div class="product-card__media">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 800 | image_tag:
        loading: 'lazy',
        widths: '300, 500, 800',
        sizes: '(min-width: 960px) 33vw, (min-width: 640px) 50vw, 100vw',
        alt: product.featured_media.alt | default: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="product-card__title">{{ product.title }}</div>
  <div class="product-card__price">
    {%- if product.price_varies -%}
      {{ 'products.product.from_price' | t: price: product.price_min | money }}
    {%- else -%}
      {{ product.price | money }}
    {%- endif -%}
    {%- unless product.available %} &middot; {{ 'products.product.sold_out' | t }}{% endunless -%}
  </div>
</a>
